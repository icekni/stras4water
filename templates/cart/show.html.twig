{# ============================================================
   Variables attendues (identiques à ton contrôleur actuel) :
   abonnements[], cartes[] (entity, tarifChoice, price, discipline),
   adhesion (bool), total
   ============================================================ #}
{% extends 'base/base.html.twig' %}

{% block title %}Mon panier | Stras4Water{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 900px;">
	<h1 class="mb-4">🛒 Mon panier</h1>

	{% if abonnements is empty and cartes is empty and not adhesion %}
		<div class="recap-s4w text-center py-5">
			<p class="h5 mb-2">Votre panier est vide</p>
			<p class="text-muted mb-3">Découvrez nos activités de danse, de langues et nos randonnées solidaires.</p>
			<a href="{{ path('home') }}#activites" class="btn btn-sinscrire rounded-pill">Découvrir les activités →</a>
		</div>
	{% else %}
		{# ===== Lignes du panier ===== #}
		<div class="card border-0 shadow-sm mb-3" style="border-radius: 10px; overflow: hidden;">
			<div class="card-body p-0">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th>Article</th>
							<th>Discipline</th>
							<th>Tarif</th>
							<th class="text-end">Prix</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for ab in abonnements %}
							<tr>
								<td><strong>{{ ab.entity.nom }}</strong></td>
								<td>{{ ab.discipline ?: '—' }}</td>
								<td>
									{% if ab.tarifChoice == 'reduit' %}
										<span class="badge rounded-pill" style="background:#fdf3d7;color:#7a5c1e;border:1px solid #f3dd9a;">Réduit</span>
									{% else %}
										<span class="niveau-pill">Normal</span>
									{% endif %}
								</td>
								<td class="text-end fw-bold">{{ ab.price|number_format(2, ',', ' ') }} €</td>
								<td>
									<a href="{{ path('cart_remove_item', {type: 'abonnement', id: ab.entity.id}) }}"
										class="btn btn-sm btn-outline-danger rounded-pill" aria-label="Retirer du panier">
										<i class="bi bi-trash"></i>
									</a>
								</td>
							</tr>
						{% endfor %}

						{% for c in cartes %}
							<tr>
								<td><strong>{{ c.entity.nom }}</strong></td>
								<td>{{ c.discipline ?: '—' }}</td>
								<td>
									{% if c.tarifChoice == 'reduit' %}
										<span class="badge rounded-pill" style="background:#fdf3d7;color:#7a5c1e;border:1px solid #f3dd9a;">Réduit</span>
									{% else %}
										<span class="niveau-pill">Normal</span>
									{% endif %}
								</td>
								<td class="text-end fw-bold">{{ c.price|number_format(2, ',', ' ') }} €</td>
								<td>
									<a href="{{ path('cart_remove_item', {type: 'carte', id: c.entity.id}) }}"
										class="btn btn-sm btn-outline-danger rounded-pill" aria-label="Retirer du panier">
										<i class="bi bi-trash"></i>
									</a>
								</td>
							</tr>
						{% endfor %}

						{% if adhesion %}
							<tr style="background: var(--s4w-bleu-bg);">
								<td>💧 <strong>Adhésion annuelle</strong> <small class="text-muted">(obligatoire, une seule fois pour l'année d'adhésion en cours)</small></td>
								<td>—</td>
								<td><span class="niveau-pill">Unique</span></td>
								{# TODO : récupérer depuis la config #}
								<td class="text-end fw-bold">{{ 10|number_format(2, ',', ' ') }} €</td>
								<td></td>
							</tr>
						{% else %}
							<tr>
								<td colspan="5">
									<span class="badge rounded-pill" style="background:#e7f7ee;color:#1e9e58;border:1px solid #bfe8cf;">
										✅ Adhésion à jour — rien à payer pour l'année d'adhésion en cours
									</span>
								</td>
							</tr>
						{% endif %}
					</tbody>
				</table>
			</div>
		</div>

		{# ===== Cross-sell : ajouter une autre activité, l'adhésion n'est due qu'une fois par année d'adhésion ===== #}
		<div class="alert-s4w-info mb-3">
			💡 Envie d'ajouter une <strong>autre activité</strong> ? L'adhésion n'est due qu'<strong>une seule fois par
			année d'adhésion</strong> : vous ne repayerez pas 10 € pour une deuxième activité, ni pour une future
			commande tant que votre adhésion est valide.
			<a href="{{ path('home') }}#activites">Voir les activités</a>.
		</div>

		{# ===== Récap total ===== #}
		<div class="recap-s4w mb-3">
			<table aria-live="polite">
				<tr class="total">
					<td>Total de la commande</td>
					<td>{{ total|number_format(2, ',', ' ') }} €</td>
				</tr>
			</table>
			<p class="text-muted small mb-0">
				Le compte n'est demandé qu'à l'étape de paiement, pour la traçabilité de votre commande.
			</p>
		</div>

		<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
			<a href="{{ path('cart_clear') }}" class="btn btn-outline-danger rounded-pill">Vider le panier</a>
			<a href="{{ path('cart_checkout') }}" class="btn btn-sinscrire btn-lg rounded-pill">
				✅ Passer au paiement
			</a>
		</div>
	{% endif %}
</div>
{% endblock %}