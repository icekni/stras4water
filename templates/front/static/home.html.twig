{% extends 'base/base.html.twig' %}

{% block title %}Stras4Water | Association solidaire à Strasbourg{% endblock %}
{% block meta_description %}
Stras4Water est une association solidaire à Strasbourg qui organise des activités de danse,
des cours de langues, des randonnées et des événements au profit de l'accès à l'eau.
{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Stras4Water",
    "url": "{{ absolute_url(path('home')) }}",
    "logo": "{{ absolute_url(asset('img/logo.png')) }}",
    "address": {
        "@type": "PostalAddress",
        "streetAddress": "1a place des Orphelins",
        "postalCode": "67000",
        "addressLocality": "Strasbourg",
        "addressCountry": "FR"
    },
    "sameAs": [
        "https://www.facebook.com/stras4water",
        "https://www.instagram.com/stras_4water"
    ]
}
</script>
{% endblock %}

{% block body %}

	{# ===== Hero overlay sombre, façon 4water.org ===== #}
	<section class="container py-4">
		<div class="hero-s4w">
			<h1 class="mb-3">Apprendre, danser, transmettre.<br>
				<em>Transformer des vies, un cours à la fois.</em>
			</h1>
			<p class="lead mx-auto mb-4" style="max-width: 640px;">
				Bachata, salsa, kizomba, cours de langues, randonnées : des activités conviviales
				et solidaires à Strasbourg. Votre première séance est offerte.
			</p>
			<div class="d-flex gap-3 justify-content-center flex-wrap">
				<a href="#activites" class="btn btn-sinscrire btn-lg rounded-pill">S'inscrire à un cours →</a>
				<a href="{{ path('planning') }}" class="btn btn-outline-light rounded-pill btn-lg">📅 Voir le planning</a>
			</div>
			<div class="d-flex gap-4 justify-content-center flex-wrap mt-4 small" style="color:#b9ccd6;">
				<span>🏅 Réseau 4Water</span>
				<span>💧 100 % des bénéfices reversés après frais</span>
				<span>🤝 Association loi 1908, reconnue d'intérêt général</span>
			</div>
		</div>
	</section>

	{# ===== Ruban arguments ===== #}
	<div class="ribbon-s4w">
		<div class="container d-flex justify-content-center gap-4 flex-wrap text-center">
			<span>🎁 1ère séance offerte dans chaque discipline</span>
			<span>💚 Adhésion 10 €/an pour toute la saison</span>
			<span>🥾 Randonnées gratuites pour les membres</span>
		</div>
	</div>

	{# ===== Activités ===== #}
	<section class="container py-5" id="activites">
		<h2 class="text-center mb-2">Nos activités à <span style="color: var(--s4w-bleu);">Strasbourg</span></h2>
		<p class="text-center text-muted mb-4">Formules et inscription directement sur la page de chaque activité.</p>

		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
			<div class="col">
				<div class="card h-100 card-activite">
					<div class="card-body">
						<h5 class="card-title">💃 Bachata</h5>
						<p class="card-text text-muted small">Mercredis 19h45 · 53 rue Saint-Urbain</p>
						<span class="badge-essai mb-2">🎁 1ère séance offerte</span><br>
						<span class="prix-from">à partir de 30 € par an</span><br>
						<a href="{{ path('bachata') }}" class="btn btn-outline-s4w rounded-pill btn-sm mt-2">S'inscrire</a>
					</div>
				</div>
			</div>
			<div class="col">
				<div class="card h-100 card-activite">
					<div class="card-body">
						<h5 class="card-title">🕺 Salsa Rueda</h5>
						<p class="card-text text-muted small">Mardi Kaleidoscoop · Mercredi St-Joseph</p>
						<span class="badge-essai mb-2">🎁 1ère séance offerte</span><br>
						<span class="prix-from">à partir de 30 € par an</span><br>
						<a href="{{ path('salsa') }}" class="btn btn-outline-s4w rounded-pill btn-sm mt-2">S'inscrire</a>
					</div>
				</div>
			</div>
			<div class="col">
				<div class="card h-100 card-activite">
					<div class="card-body">
						<h5 class="card-title">🌀 Kizomba</h5>
						<p class="card-text text-muted small">Stages ponctuels — soyez averti·e des prochaines dates</p>
						<span class="badge-essai mb-2">🔔 Alerte à l'ouverture</span><br>
						<span class="prix-from">Stages ponctuels</span><br>
						<a href="{{ path('kizomba') }}" class="btn btn-outline-s4w rounded-pill btn-sm mt-2">En savoir plus</a>
					</div>
				</div>
			</div>
			<div class="col">
				<div class="card h-100 card-activite">
					<div class="card-body">
						<h5 class="card-title">🇬🇧 Anglais</h5>
						<p class="card-text text-muted small">Jeudis 18h30 · Maison des Associations</p>
						<span class="badge-essai mb-2">🎁 1er cours offert</span><br>
						<span class="prix-from">à partir de 30 € par an</span><br>
						<a href="{{ path('anglais') }}" class="btn btn-outline-s4w rounded-pill btn-sm mt-2">S'inscrire</a>
					</div>
				</div>
			</div>
			<div class="col">
				<div class="card h-100 card-activite">
					<div class="card-body">
						<h5 class="card-title">🇪🇸 Espagnol</h5>
						<p class="card-text text-muted small">Jeudis 19h30 · Maison des Associations</p>
						<span class="badge-essai mb-2">🎁 1er cours offert</span><br>
						<span class="prix-from">à partir de 30 € par an</span><br>
						<a href="{{ path('espagnol') }}" class="btn btn-outline-s4w rounded-pill btn-sm mt-2">S'inscrire</a>
					</div>
				</div>
			</div>
			<div class="col">
				<div class="card h-100 card-activite">
					<div class="card-body">
						<h5 class="card-title">🥾 Randonnée</h5>
						<p class="card-text text-muted small">Sorties en Alsace, tous niveaux, covoiturage possible</p>
						<span class="badge-membre mb-2">Réservé adhérents</span><br>
						<span class="prix-from">Sorties gratuites</span><br>
						<a href="{{ path('rando') }}" class="btn btn-outline-s4w rounded-pill btn-sm mt-2">En savoir plus</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	{# ===== Chiffres sur bandeau charbon (données 4Water/WaterAid à jour, oct. 2026) ===== #}
	<section class="container pb-4">
		<div class="darkstats">
			<div class="row text-center">
				<div class="col-6 col-md-3">
					<b>+ de 640 000 £</b>
					<small>reversés à WaterAid et Welthungerhilfe par le réseau 4Water</small>
				</div>
				<div class="col-6 col-md-3">
					<b>29 millions</b>
					<small>de personnes ont accédé à l'eau potable grâce à WaterAid depuis 1981</small>
				</div>
				<div class="col-6 col-md-3">
					<b>100 %</b>
					<small>de nos bénéfices (après frais : salles, SACEM, assurance) reversés</small>
				</div>
				<div class="col-6 col-md-3">
					<b>+ de 500</b>
					<small>danseurs à nos soirées en 2025</small>
				</div>
			</div>
		</div>
	</section>

	{# ===== Fun in fundraising + don ===== #}
	<section class="container py-5">
		<div class="row align-items-center g-4">
			<div class="col-lg-6">
				<h2 class="mb-3">Fun in <span style="color: var(--s4w-bleu);">fundraising</span> 💚</h2>
				<p class="mb-4">
					On partage ce qu'on aime — danse, langues, randonnées — et on reverse l'intégralité de nos
					bénéfices à <strong>WaterAid</strong>, membre du réseau 4Water. Les dons complètent les recettes
					des activités : chaque contribution finance des projets d'accès à l'eau durables.
				</p>
				<a href="{{ path('donation') }}" class="btn btn-success rounded-pill btn-lg">Je fais un don</a>
			</div>
			<div class="col-lg-6 d-flex justify-content-center">
				<img src="{{ asset('img/aide.png') }}" alt="Soutenir notre action" class="img-fluid rounded" style="max-height: 300px;">
			</div>
		</div>
	</section>
{% endblock %}