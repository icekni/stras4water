{% extends 'base/base.html.twig' %}

{% block title %}Faire un don | Stras4Water{% endblock %}

{% block body %}
<div class="container mt-5 d-flex justify-content-center">
	<div class="col-md-6">
		<h1 class="mb-2 text-center">Faire un don 💧</h1>
		<p class="text-muted text-center mb-4">
			100 % des bénéfices de nos activités financent l'accès à l'eau via WaterAid.
			Votre don s'y ajoute intégralement.
		</p>

		<div class="card border-0 shadow-sm p-4" style="border-radius: 10px;">
			{{ form_start(form) }}

				<div class="mb-3">
					{{ form_label(form.montant) }}
					{{ form_widget(form.montant, {'attr': {'id': 'montantDon', 'class': 'form-control'}}) }}
					{{ form_errors(form.montant) }}
				</div>

				<div id="donInfo" class="recap-s4w d-none mt-2 mb-3">
					<table>
						<tr>
							<td>Montant donné</td>
							<td><span id="donMontant">0</span> €</td>
						</tr>
						<tr>
							<td>Déduction fiscale (66 %)</td>
							<td><span id="reduction">0</span> €</td>
						</tr>
						<tr class="total">
							<td>Coût réel après déduction</td>
							<td><span id="montantReel">0</span> €</td>
						</tr>
					</table>
					<p class="fiscal-note mb-0">💚 <small>(Si vous cochez l'option « Je souhaite un reçu fiscal »)</small></p>
				</div>

				<div class="mb-3">
					{{ form_row(form.wantsRecuFiscal) }}
				</div>

				<div id="emailField" style="display: none;">
					{{ form_row(form.email) }}
				</div>

				<button class="btn btn-success btn-lg rounded-pill w-100">Je fais un don</button>
			{{ form_end(form) }}
		</div>

		<div class="alert-s4w-info mt-3">
			🧾 Le reçu fiscal est émis uniquement pour les dons sans contrepartie, conformément à l'article 200 du CGI.
		</div>
	</div>
</div>

<script>
	// Affichage de l'email selon la case "reçu fiscal"
	const checkboxRecu = document.getElementById('donation_wantsRecuFiscal');
	const emailField = document.getElementById('emailField');

	checkboxRecu.addEventListener('change', function () {
		emailField.style.display = this.checked ? 'block' : 'none';
	});
	if (checkboxRecu.checked) {
		emailField.style.display = 'block';
	}

	// Calcul dynamique du coût réel après déduction (dons uniquement)
	const montantInput = document.getElementById('donation_montant');
	const donInfo = document.getElementById('donInfo');
	const donMontant = document.getElementById('donMontant');
	const reduction = document.getElementById('reduction');
	const montantReel = document.getElementById('montantReel');

	montantInput.addEventListener('input', function () {
		let valeur = this.value.trim().replace(',', '.');
		const montant = parseFloat(valeur);

		if (!isNaN(montant) && montant > 0) {
			const reduc = montant * 0.66;
			const net = montant - reduc;

			donMontant.textContent = montant.toFixed(2);
			reduction.textContent = reduc.toFixed(2);
			montantReel.textContent = net.toFixed(2);
			donInfo.classList.remove('d-none');
		} else {
			donInfo.classList.add('d-none');
		}
	});
</script>
{% endblock %}