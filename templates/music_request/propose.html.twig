{% extends 'base/base.html.twig' %}

{% block title %}Proposer un morceau{% endblock %}

{% block body %}

<div class="container py-4">

    <h1 class="mb-3">Proposer un morceau</h1>

    <div class="alert alert-info mb-4">
        <strong>🎵 Comment ça marche ?</strong><br>
        Propose ton morceau et fais-le voter par les autres danseurs.
        <strong>À {{ nbVotesRequis }} votes, il est validé.</strong><br>
        Tu ne veux pas attendre ?
        <strong>Tu peux aussi le faire passer immédiatement pour {{ price }}€.</strong>
    </div>

    <div class="row g-4">

        {# Formulaire #}

        <div class="col-12 col-lg-5">

            <div class="card h-100">
                <div class="card-body">

                    <h2 class="h4 mb-3">
                        Proposer un morceau
                    </h2>

                    {{ form_start(form) }}

                        {{ form_row(form.titre) }}
                        {{ form_row(form.artiste) }}
                        {{ form_row(form.youtubeUrl) }}

                        <div class="mt-3">
                            {{ form_row(form.submit, {
                                'attr': {
                                    'class': 'btn btn-primary w-100'
                                }
                            }) }}
                        </div>

                    {{ form_end(form) }}

                </div>
            </div>

        </div>


        {# Liste des morceaux #}

        <div class="col-12 col-lg-7">

            <div class="card">
                <div class="card-body">

                    <h2 class="h4 mb-3">
                        Morceaux proposés
                    </h2>

                    {% if musicRequests|length > 0 %}

                        <div class="d-flex flex-column gap-3">

                            {% for musicRequest in musicRequests %}

                                <div class="border rounded p-3">

                                    <div class="d-flex justify-content-between align-items-start gap-3">

                                        <div>
                                            <h3 class="h5 mb-1">
                                                {{ musicRequest.titre }}
                                            </h3>

                                            <div class="text-muted">
                                                {{ musicRequest.artiste }}
                                            </div>
                                        </div>

                                        <div class="text-end text-nowrap">
                                            <strong>
                                                {{ musicRequest.votes }}
                                            </strong>

                                            <div class="small text-muted">
                                                vote{% if musicRequest.votes != 1 %}s{% endif %}
                                            </div>
                                        </div>

                                    </div>


                                    {# Progression vers les X votes #}

                                    <div class="mt-3">

                                        <div class="progress" style="height: 8px;">
                                            <div
                                                class="progress-bar"
                                                role="progressbar"
                                                style="width: {{ min(100, musicRequest.votes * 10) }}%;"
                                                aria-valuenow="{{ musicRequest.votes }}"
                                                aria-valuemin="0"
                                                aria-valuemax="10"
                                            ></div>
                                        </div>

                                        <div class="small text-muted mt-1">
                                            {{ musicRequest.votes }}/{{ nbVotesRequis }} votes
                                        </div>

                                    </div>


                                    {# Actions #}

                                    <div class="d-flex flex-wrap gap-2 mt-3">

                                        <form
                                            method="post"
                                            action="{{ path('music_request_vote', {
                                                id: musicRequest.id
                                            }) }}"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('music_request_vote_' ~ musicRequest.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-outline-primary"
                                            >
                                                👍 Voter
                                            </button>
                                        </form>

                                        <form
                                            method="post"
                                            action="{{ path('music_request_pay', {
                                                id: musicRequest.id
                                            }) }}"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('music_request_pay_' ~ musicRequest.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-outline-success"
                                            >
                                                💶 Valider sans attendre : {{ price }} €
                                            </button>
                                        </form>

                                    </div>

                                </div>

                            {% endfor %}

                        </div>

                    {% else %}

                        <div class="text-center text-muted py-4">
                            <p class="mb-0">
                                Aucun morceau n'a encore été proposé.
                            </p>

                            <small>
                                Sois le premier à en proposer un !
                            </small>
                        </div>

                    {% endif %}

                </div>
            </div>

        </div>

    </div>

</div>

{% endblock %}
