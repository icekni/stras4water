{# templates/display/live.html.twig #}

{% set musicRequest = state.musicRequest ?? {} %}
{% set current = state.current ?? {} %}
{% set previous = state.previous ?? {} %}
{% set next = state.next ?? [] %}
{% set events = state.events ?? [] %}
{% set nextStyle = state.nextStyle ?? {} %}

<!DOCTYPE html>

<html lang="fr">

<head>

<meta charset="UTF-8">

<title>Stras4Water Live</title>

<meta
    name="viewport"
    content="width=device-width, initial-scale=1"
>

<style>

/*
 * ============================================================
 * VARIABLES
 * ============================================================
 */

:root {
    --accent:#d64040;
    --background:#350909;

    --card:rgba(255,255,255,.08);

    --text:white;
    --muted:rgba(255,255,255,.65);
}


/*
 * ============================================================
 * GLOBAL
 * ============================================================
 */

* {
    box-sizing:border-box;
}

html,
body {
    width:100%;
    height:100%;

    margin:0;

    overflow:hidden;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    color:var(--text);

    background:var(--background);
}

body {
    transition:
        background-color 1s ease;
}


/*
 * ============================================================
 * STYLES PAR DISCIPLINE
 * ============================================================
 */

body.salsa {
    --accent:#d64040;
    --background:#350909;
}

body.bachata {
    --accent:#9b59d8;
    --background:#24102f;
}

body.kizomba {
    --accent:#3b82f6;
    --background:#081b38;
}


/*
 * ============================================================
 * BACKGROUND
 * ============================================================
 */

.cover-background {
    position:fixed;

    inset:-60px;

    background-image:
        url('{{ current.cover|default(asset('img/default-cover.png')) }}');

    background-size:cover;

    background-position:center;

    filter:blur(50px);

    opacity:.18;

    transform:scale(1.2);
}

.overlay {
    position:fixed;

    inset:0;

    background:
        linear-gradient(
            rgba(0,0,0,.55),
            rgba(0,0,0,.85)
        );
}


/*
 * ============================================================
 * SCREEN
 * ============================================================
 */

.screen {
    position:relative;

    z-index:2;

    height:100vh;

    display:grid;

    grid-template-rows:
        60px
        minmax(0,1fr)
        70px
        180px;

    padding:20px;

    gap:15px;

    overflow:hidden;
}


/*
 * ============================================================
 * HEADER
 * ============================================================
 */

.header {
    display:flex;

    justify-content:space-between;

    align-items:center;
}

.logo {
    font-size:clamp(
        1rem,
        2vw,
        1.5rem
    );

    font-weight:bold;

    letter-spacing:3px;
}

.logo img {
    max-height:80px;

    width:auto;
}

#clock {
    font-size:1rem;
}


/*
 * ============================================================
 * MAIN
 * ============================================================
 */

.main {
    display:grid;

    grid-template-columns:
        minmax(0,20%)
        minmax(0,60%)
        minmax(0,20%);

    gap:15px;

    min-height:0;
}


/*
 * ============================================================
 * CARDS
 * ============================================================
 */

.card {
    min-width:0;

    background:var(--card);

    backdrop-filter:blur(15px);

    border-radius:25px;

    padding:20px;

    overflow:hidden;
}


/*
 * ============================================================
 * SIDE SONGS
 * ============================================================
 */

.side-title {
    color:var(--muted);

    text-transform:uppercase;

    font-size:.85rem;

    margin-bottom:20px;
}

.small-style {
    color:var(--accent);

    font-weight:bold;
}

.small-title {
    margin-top:8px;

    font-size:clamp(
        1rem,
        1.3vw,
        1.3rem
    );

    font-weight:bold;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;
}

.small-artist {
    color:var(--muted);

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;
}


/*
 * ============================================================
 * CURRENT SONG
 * ============================================================
 */

.current {
    min-width:0;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    background:var(--card);

    backdrop-filter:blur(20px);

    border-radius:30px;
}

.cover {
    width:clamp(
        150px,
        15vw,
        220px
    );

    height:clamp(
        150px,
        15vw,
        220px
    );

    object-fit:cover;

    border-radius:20px;

    box-shadow:
        0 20px 50px rgba(0,0,0,.5);
}

.style {
    margin-top:20px;

    font-size:clamp(
        1.2rem,
        2vw,
        2rem
    );

    font-weight:bold;

    color:var(--accent);
}


/*
 * ============================================================
 * CURRENT TITLE
 * ============================================================
 */

.current-title-wrapper {
    width:80%;

    overflow:hidden;

    white-space:nowrap;

    text-align:center;
}

.current-title {
    display:inline-block;

    font-size:clamp(
        2rem,
        3vw,
        3rem
    );

    font-weight:bold;
}

.current-title.scroll {
    animation:
        marquee 14s linear infinite;
}

@keyframes marquee {

    0%,
    20% {
        transform:translateX(0);
    }

    80%,
    100% {
        transform:translateX(-50%);
    }
}


/*
 * ============================================================
 * ARTIST
 * ============================================================
 */

.artist-wrapper {
    width:80%;

    overflow:hidden;

    white-space:nowrap;

    text-align:center;
}

.artist {
    display:inline-block;

    font-size:clamp(
        1rem,
        1.5vw,
        1.8rem
    );

    opacity:.75;
}

.artist.scroll {
    animation:
        marquee 14s linear infinite;
}


/*
 * ============================================================
 * PROGRESS
 * ============================================================
 */

.progress-container {
    width:75%;

    margin-top:25px;
}

.progress {
    height:12px;

    background:rgba(255,255,255,.2);

    border-radius:20px;

    overflow:hidden;
}

.progress-bar {
    height:100%;

    width:0%;

    background:var(--accent);
}

.time {
    text-align:center;

    margin-top:8px;

    color:var(--muted);
}


/*
 * ============================================================
 * NEXT STYLE
 * ============================================================
 */

.next-style {
    display:flex;

    justify-content:center;

    align-items:center;

    border-left:
        8px solid var(--accent);

    background:var(--card);

    backdrop-filter:blur(15px);

    border-radius:20px;

    font-size:clamp(
        1rem,
        2vw,
        1.8rem
    );

    font-weight:bold;
}


/*
 * ============================================================
 * BOTTOM
 *
 * 40% à gauche :
 * suggestion de musique
 *
 * 60% à droite :
 * événements
 * ============================================================
 */

.bottom {
    display:grid;

    grid-template-columns:        
        minmax(0,40%)
        minmax(0,60%);

    gap:15px;

    min-height:0;
}


/*
 * ============================================================
 * MUSIC REQUEST
 * ============================================================
 */

.qr {
    display:flex;

    align-items:center;

    gap:25px;
}

.qr img {
    width:110px;

    height:110px;

    background:white;

    padding:10px;

    border-radius:10px;
}

.music-request-link {
    display:none;

    margin-top:15px;

    padding:12px 20px;

    border-radius:12px;

    background:var(--accent);

    color:white;

    text-decoration:none;

    font-weight:bold;
}


/*
 * ============================================================
 * EVENTS
 * ============================================================
 *
 * La carte prend toute la largeur disponible
 * dans les 60% réservés aux événements.
 *
 * Un seul événement est affiché à la fois.
 */

.events {
    width:100%;

    height:100%;

    padding:20px 25px;
}

.events-container {
    width:100%;

    height:100%;

    min-height:0;

    display:flex;

    align-items:center;

    justify-content:center;

    overflow:hidden;
}

.event-slide {
    width:100%;

    display:grid;

    grid-template-columns:
        minmax(0,1fr)
        auto;

    align-items:center;

    gap:30px;

    opacity:1;

    transform:translateY(0);

    transition:
        opacity .8s ease,
        transform .8s ease;
}

.event-slide.hidden {
    opacity:0;

    transform:translateY(15px);
}

.event-info {
    min-width:0;

    overflow:hidden;
}

.event-date {
    color:var(--accent);

    font-size:clamp(
        1rem,
        1.4vw,
        1.3rem
    );

    font-weight:bold;

    margin-bottom:6px;
}

.event-name {
    font-size:clamp(
        1.4rem,
        2vw,
        2.1rem
    );

    font-weight:bold;

    line-height:1.15;

    margin-bottom:8px;
}

.event-location {
    color:var(--muted);

    font-size:clamp(
        1rem,
        1.3vw,
        1.2rem
    );

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;
}

.event-links {
    display:flex;

    align-items:flex-start;

    justify-content:flex-end;

    gap:20px;

    flex-shrink:0;
}

.event-link {
    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:flex-start;

    gap:5px;

    min-width:90px;

    color:var(--text);

    font-size:.85rem;

    text-align:center;
}

.event-link img {
    display:block;

    width:95px;

    height:95px;

    padding:5px;

    background:white;

    border-radius:8px;

    object-fit:contain;
}


/*
 * ============================================================
 * MOBILE
 * ============================================================
 */

@media (max-width:768px) {

    html,
    body {
        width:100%;

        height:auto;

        min-height:100%;

        overflow-x:hidden;

        overflow-y:auto;
    }


    .screen {
        height:auto;

        min-height:100vh;

        display:flex;

        flex-direction:column;

        padding:12px;

        gap:12px;

        overflow:visible;
    }


    /*
     * HEADER
     */

    .header {
        min-height:50px;
    }

    .logo img {
        height:50px;
    }

    #clock {
        font-size:.9rem;
    }


    /*
     * MAIN
     */

    .main {
        display:flex;

        flex-direction:column;

        gap:12px;
    }


    /*
     * ORDRE MOBILE
     */

    .main > .current {
        order:1;
    }

    .main > .card:first-child {
        order:2;
    }

    .main > .card:last-child {
        order:3;
    }


    /*
     * CURRENT
     */

    .current {
        min-height:430px;

        padding:25px 15px;
    }

    .cover {
        width:min(
            70vw,
            280px
        );

        height:min(
            70vw,
            280px
        );
    }

    .style {
        margin-top:15px;

        font-size:1.3rem;
    }

    .current-title-wrapper {
        width:100%;
    }

    .current-title {
        font-size:clamp(
            1.6rem,
            7vw,
            2.2rem
        );
    }

    .artist-wrapper {
        width:90%;
    }

    .artist {
        font-size:1.1rem;
    }

    .progress-container {
        width:90%;

        margin-top:20px;
    }


    /*
     * CARDS
     */

    .card {
        padding:16px;

        border-radius:20px;
    }

    .side-title {
        margin-bottom:12px;
    }

    .main > .card:first-child {
        min-height:auto;
    }


    /*
     * NEXT STYLE
     */

    .next-style {
        min-height:70px;

        padding:15px;

        text-align:center;

        font-size:1.1rem;

        border-left-width:5px;
    }


    /*
     * BOTTOM
     */

    .bottom {
        display:flex;

        flex-direction:column;

        gap:12px;
    }


    /*
     * MUSIC REQUEST
     */

    .qr {
        flex-direction:column;

        text-align:center;

        gap:15px;
    }

    .qr-image {
        display:none;
    }

    .music-request-link {
        display:inline-block;
    }


    /*
     * EVENTS
     */

    .events {
        width:100%;

        height:auto;

        padding:16px;
    }

    .events-container {
        min-height:220px;

        height:auto;
    }

    .event-slide {
        grid-template-columns:1fr;

        gap:15px;

        text-align:center;
    }

    .event-date {
        font-size:1rem;
    }

    .event-name {
        font-size:1.4rem;
    }

    .event-location {
        font-size:1rem;
    }

    .event-links {
        gap:15px;

        justify-content:center;
    }

    .event-link img {
        width:85px;

        height:85px;
    }

}


/*
 * ============================================================
 * JAVASCRIPT
 * ============================================================
 */

</style>

</head>


<body class="{{ current.style|default('salsa') }}">


<div class="cover-background"></div>

<div class="overlay"></div>


<div class="screen">


    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="header">

        <div class="logo">

            <img
                src="{{ asset('img/logo.png') }}"
                alt="Logo Stras4Water"
                height="80"
            >

        </div>


        <div id="clock">
            🕒 21:43
        </div>

    </div>


    <!-- ======================================================
         MAIN
         ====================================================== -->

    <div class="main">


        <!-- PREVIOUS -->

        <div class="card">

            <div class="side-title">
                ✓ Précédente
            </div>

            <div class="small-style">

                {{ previous.icon|default('') }}

                {{ previous.style|default('')|upper }}

            </div>

            <div class="small-title">

                {{ previous.title|default('') }}

            </div>

            <div class="small-artist">

                {{ previous.artist|default('') }}

            </div>

        </div>


        <!-- CURRENT -->

        <div class="current">

            {% set hasCurrentTrack =
                current.title|default('')|trim != ''
            %}

            {% set cover =
                current.cover
                ?? asset('img/default-cover.png')
            %}


            <img
                class="cover"

                src="{{ cover }}"

                alt="{{ current.title|default('') }}"

                {% if not hasCurrentTrack %}
                    style="visibility:hidden"
                {% endif %}
            >


            <div
                class="style"

                {% if not hasCurrentTrack %}
                    style="visibility:hidden"
                {% endif %}
            >

                {{ current.icon|default('') }}

                {{ current.style|default('')|upper }}

            </div>


            <div class="current-title-wrapper">

                <div
                    class="current-title"

                    {% if not hasCurrentTrack %}
                        style="visibility:hidden"
                    {% endif %}
                >

                    {% if hasCurrentTrack %}
                        {{ current.title }}
                    {% endif %}

                </div>

            </div>


            <div
                class="artist-wrapper"

                {% if not hasCurrentTrack %}
                    style="visibility:hidden"
                {% endif %}
            >

                <div class="artist">

                    {% if hasCurrentTrack %}
                        {{ current.artist|default('') }}
                    {% endif %}

                </div>

            </div>


            <div class="progress-container">

                <div class="progress">

                    <div class="progress-bar"></div>

                </div>


                <div class="time">

                    <span id="elapsed"></span>

                    /

                    <span id="duration"></span>

                </div>

            </div>

        </div>


        <!-- NEXT -->

        <div class="card">

            <div class="side-title">
                ⏭ Ensuite
            </div>


            {% for song in next %}

                {% if song.title|default('')|trim != '' %}

                    <div class="small-style">

                        {{ song.icon }}

                        {{ song.style|upper }}

                    </div>


                    <div class="small-title">

                        {{ song.title }}

                    </div>


                    <div class="small-artist">

                        {{ song.artist }}

                    </div>


                    {% if not loop.last %}

                        <hr>

                    {% endif %}

                {% endif %}

            {% endfor %}

        </div>

    </div>


    <!-- ======================================================
         NEXT STYLE
         ====================================================== -->

    <div class="next-style">

        🕺 Dans

        {{ nextStyle.count|default(2) }}

        morceaux :

        &nbsp;

        {{ nextStyle.icon|default('🟣') }}

        {{ nextStyle.style|default('bachata')|upper }}

        &nbsp;

        (≈

        {{ nextStyle.minutes|default(8) }}

        min)

    </div>


    <!-- ======================================================
         BOTTOM
         ====================================================== -->

    <div class="bottom">


        <!-- ==================================================
             FUTUR BLOC :
             PROPOSER UNE MUSIQUE
             ================================================== -->

        <div class="card qr">

            <img
                class="qr-image"

                src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={{ absolute_url('/proposer-musique') }}"

                alt="QR Code pour proposer une musique"
            >

            <div>

                <h2>
                    📱 Proposer une musique
                </h2>

                👍 {{ musicRequest.votesRequired|default(10) }} votes
                → gratuit

                <br>

                ⚡ {{ musicRequest.price|default(2) }} €
                → sans attendre les votes

                <a
                    class="music-request-link"

                    href="{{ path('music_request') }}"
                >
                    🎵 Proposer une musique
                </a>

            </div>

        </div>


        <!-- ==================================================
             EVENTS
             ================================================== -->

        <div class="card events">

            <div class="events-container">

                <div class="event-slide"></div>

            </div>

        </div>

    </div>

</div>


<script>


/*
 * ============================================================
 * TIMER
 * ============================================================
 */

let elapsed =
    Number(
        {{ current.elapsed|default(0)|json_encode|raw }}
    );

let duration =
    Number(
        {{ current.duration|default(1)|json_encode|raw }}
    );

let measuredAt =
    {{ current.measuredAt|default(null)|json_encode|raw }};

let elapsedAtMeasurement =
    elapsed;

let measuredTimestamp =
    null;

let currentTrackKey =
    null;


if (measuredAt) {

    measuredTimestamp =
        new Date(
            measuredAt
        ).getTime();


    if (
        Number.isNaN(
            measuredTimestamp
        )
    ) {

        measuredTimestamp =
            null;
    }
}


function formatTime(seconds)
{
    seconds =
        Math.max(
            0,
            Math.floor(
                Number(seconds)
                ||
                0
            )
        );


    const min =
        Math.floor(
            seconds / 60
        );


    const sec =
        seconds % 60;


    return (
        min
        +
        ':'
        +
        String(sec).padStart(
            2,
            '0'
        )
    );
}


function getCurrentElapsed()
{
    if (
        measuredTimestamp
        !==
        null
    ) {

        const elapsedNow =
            elapsedAtMeasurement
            +
            (
                Date.now()
                -
                measuredTimestamp
            )
            /
            1000;


        return Math.min(
            duration,

            Math.max(
                0,
                elapsedNow
            )
        );
    }


    return Math.min(
        duration,

        Math.max(
            0,
            elapsed
        )
    );
}


function refreshProgress()
{
    const currentElapsed =
        getCurrentElapsed();


    const progressBar =
        document.querySelector(
            '.progress-bar'
        );


    const elapsedElement =
        document.querySelector(
            '#elapsed'
        );


    const durationElement =
        document.querySelector(
            '#duration'
        );


    if (
        !progressBar
        ||
        !elapsedElement
        ||
        !durationElement
    ) {
        return;
    }


    const percentage =
        duration > 0
            ?
            (
                currentElapsed
                /
                duration
            )
            *
            100
            :
            0;


    progressBar.style.width =
        Math.min(
            100,
            Math.max(
                0,
                percentage
            )
        )
        +
        '%';


    elapsedElement.innerText =
        formatTime(
            currentElapsed
        );


    durationElement.innerText =
        formatTime(
            duration
        );
}


refreshProgress();


setInterval(
    refreshProgress,
    250
);


/*
 * ============================================================
 * DÉFILEMENT TEXTE
 * ============================================================
 */

function checkTextOverflow(
    elementSelector,
    wrapperSelector
)
{
    const element =
        document.querySelector(
            elementSelector
        );


    const wrapper =
        document.querySelector(
            wrapperSelector
        );


    if (
        !element
        ||
        !wrapper
    ) {
        return;
    }


    element.classList.remove(
        'scroll'
    );


    if (
        element.scrollWidth
        >
        wrapper.clientWidth
    ) {

        element.classList.add(
            'scroll'
        );
    }
}


function checkTitleOverflow()
{
    checkTextOverflow(
        '.current-title',
        '.current-title-wrapper'
    );
}


function checkArtistOverflow()
{
    checkTextOverflow(
        '.artist',
        '.artist-wrapper'
    );
}


/*
 * ============================================================
 * ÉVÉNEMENTS
 * ============================================================
 */

let liveEvents = [];

let currentEventIndex = 0;

let eventCarouselTimer = null;


function escapeHtml(value)
{
    const div =
        document.createElement(
            'div'
        );


    div.textContent =
        String(
            value ?? ''
        );


    return div.innerHTML;
}


function renderEvent(event)
{
    const slide =
        document.querySelector(
            '.event-slide'
        );


    if (!slide) {
        return;
    }


    if (!event) {

        slide.innerHTML =
            '';

        return;
    }


    const links =
        event.links
        ??
        [];


    let linksHtml =
        '';


    if (links.length > 0) {

        linksHtml =
            '<div class="event-links">'
            +

            links.map(
                function(link)
                {
                    return (

                        '<div class="event-link">'

                        +

                        '<img src="'
                        +
                        escapeHtml(
                            link.qrCode
                        )
                        +
                        '" alt="QR Code '
                        +
                        escapeHtml(
                            link.nom
                        )
                        +
                        '">'

                        +

                        '<span>'
                        +
                        escapeHtml(
                            link.nom
                        )
                        +
                        '</span>'

                        +

                        '</div>'
                    );
                }
            ).join('')

            +

            '</div>';
    }


    slide.innerHTML =

        '<div class="event-info">'

        +

        '<div class="event-date">'

        +

        escapeHtml(
            event.date
            ??
            ''
        )

        +

        ' · '

        +

        escapeHtml(
            event.heure
            ??
            ''
        )

        +

        '</div>'

        +

        '<div class="event-name">'

        +

        escapeHtml(
            event.nom
            ??
            ''
        )

        +

        '</div>'

        +

        (
            event.location
            ?

            '<div class="event-location">'
            +
            '📍 '
            +
            escapeHtml(
                event.location
            )
            +
            '</div>'

            :

            ''
        )

        +

        '</div>'

        +

        linksHtml;
}


function showEvent(index)
{
    const slide =
        document.querySelector(
            '.event-slide'
        );


    if (
        !slide
        ||
        liveEvents.length === 0
    ) {
        return;
    }


    currentEventIndex =
        index %
        liveEvents.length;


    slide.classList.add(
        'hidden'
    );


    setTimeout(
        function()
        {
            renderEvent(
                liveEvents[
                    currentEventIndex
                ]
            );


            slide.classList.remove(
                'hidden'
            );

        },
        800
    );
}


function updateEvents(events)
{
    const newEvents =
        Array.isArray(events)
            ?
            events
            :
            [];


    const changed =
        JSON.stringify(
            newEvents
        )
        !==
        JSON.stringify(
            liveEvents
        );


    if (!changed) {
        return;
    }


    liveEvents =
        newEvents;


    currentEventIndex =
        0;


    if (eventCarouselTimer) {

        clearInterval(
            eventCarouselTimer
        );

        eventCarouselTimer =
            null;
    }


    if (liveEvents.length === 0) {

        renderEvent(
            null
        );

        return;
    }


    showEvent(
        0
    );


    if (
        liveEvents.length > 1
    ) {

        eventCarouselTimer =
            setInterval(
                function()
                {
                    showEvent(
                        currentEventIndex
                        +
                        1
                    );
                },
                5000
            );
    }
}


/*
 * ============================================================
 * UPDATE DISPLAY
 * ============================================================
 */

function updateDisplay(state)
{
    if (
        !state
        ||
        !state.current
    ) {
        return;
    }


    const current =
        state.current;


    const previous =
        state.previous
        ||
        {};


    const next =
        (
            state.next
            ||
            []
        )
        .filter(
            function(song)
            {
                return (
                    String(
                        song.title
                        ??
                        ''
                    )
                    .trim()
                    !==
                    ''
                );
            }
        );


    const nextStyle =
        state.nextStyle
        ||
        {};


    /*
     * ÉVÉNEMENTS
     */

    updateEvents(
        state.events
        ??
        []
    );


    /*
     * IDENTIFICATION DU MORCEAU
     */

    const newTrackKey =
        String(
            current.artist
            ??
            ''
        )
        +
        '|'
        +
        String(
            current.title
            ??
            ''
        )
        +
        '|'
        +
        String(
            current.filePath
            ??
            ''
        );


    const trackChanged =
        newTrackKey
        !==
        currentTrackKey;


    /*
     * MORCEAU ACTUEL
     */

    const currentStyle =
        document.querySelector(
            '.style'
        );


    const currentTitle =
        document.querySelector(
            '.current-title'
        );


    const currentArtist =
        document.querySelector(
            '.artist'
        );


    const currentArtistWrapper =
        document.querySelector(
            '.artist-wrapper'
        );


    const currentCover =
        document.querySelector(
            '.cover'
        );


    const hasCurrentTrack =
        String(
            current.title
            ??
            ''
        )
        .trim()
        !==
        '';


    if (hasCurrentTrack) {

        if (currentStyle) {

            currentStyle.innerText =
                String(
                    current.icon
                    ??
                    ''
                )
                +
                ' '
                +
                String(
                    current.style
                    ??
                    ''
                )
                .toUpperCase();


            currentStyle.style.visibility =
                'visible';
        }


        if (currentTitle) {

            currentTitle.innerText =
                current.title
                ??
                '';


            currentTitle.style.visibility =
                'visible';


            if (trackChanged) {

                currentTitle.classList.remove(
                    'scroll'
                );
            }
        }


        if (currentArtist) {

            currentArtist.innerText =
                current.artist
                ??
                '';


            currentArtist.classList.remove(
                'scroll'
            );


            currentArtist.style.visibility =
                'visible';
        }


        if (currentArtistWrapper) {

            currentArtistWrapper.style.visibility =
                'visible';
        }


        if (
            currentCover
            &&
            current.cover
        ) {

            currentCover.src =
                current.cover;


            currentCover.alt =
                current.title
                ??
                '';


            currentCover.style.visibility =
                'visible';
        }


    } else {

        /*
         * AUCUN MORCEAU
         */

        if (currentStyle) {

            currentStyle.innerText =
                '';

            currentStyle.style.visibility =
                'hidden';
        }


        if (currentTitle) {

            currentTitle.innerText =
                '';

            currentTitle.classList.remove(
                'scroll'
            );

            currentTitle.style.visibility =
                'hidden';
        }


        if (currentArtist) {

            currentArtist.innerText =
                '';

            currentArtist.classList.remove(
                'scroll'
            );

            currentArtist.style.visibility =
                'hidden';
        }


        if (currentArtistWrapper) {

            currentArtistWrapper.style.visibility =
                'hidden';
        }


        if (currentCover) {

            currentCover.style.visibility =
                'hidden';
        }

    }


    /*
     * MORCEAU PRÉCÉDENT
     */

    const previousCard =
        document.querySelector(
            '.main > .card:first-child'
        );


    if (previousCard) {

        const previousStyleElement =
            previousCard.querySelector(
                '.small-style'
            );


        const previousTitleElement =
            previousCard.querySelector(
                '.small-title'
            );


        const previousArtistElement =
            previousCard.querySelector(
                '.small-artist'
            );


        if (previousStyleElement) {

            previousStyleElement.innerText =
                String(
                    previous.icon
                    ??
                    ''
                )
                +
                ' '
                +
                String(
                    previous.style
                    ??
                    ''
                )
                .toUpperCase();
        }


        if (previousTitleElement) {

            previousTitleElement.innerText =
                previous.title
                ??
                '';
        }


        if (previousArtistElement) {

            previousArtistElement.innerText =
                previous.artist
                ??
                '';
        }

    }


    /*
     * MORCEAUX SUIVANTS
     */

    const nextCard =
        document.querySelector(
            '.main > .card:last-child'
        );


    if (nextCard) {

        const sideTitle =
            nextCard.querySelector(
                '.side-title'
            );


        nextCard.innerHTML =
            '';


        if (sideTitle) {

            nextCard.appendChild(
                sideTitle
            );

        } else {

            const title =
                document.createElement(
                    'div'
                );


            title.className =
                'side-title';


            title.innerText =
                '⏭ Ensuite';


            nextCard.appendChild(
                title
            );
        }


        next.forEach(
            function(
                song,
                index
            )
            {

                const style =
                    document.createElement(
                        'div'
                    );


                style.className =
                    'small-style';


                style.innerText =
                    String(
                        song.icon
                        ??
                        ''
                    )
                    +
                    ' '
                    +
                    String(
                        song.style
                        ??
                        ''
                    )
                    .toUpperCase();


                const title =
                    document.createElement(
                        'div'
                    );


                title.className =
                    'small-title';


                title.innerText =
                    song.title
                    ??
                    '';


                const artist =
                    document.createElement(
                        'div'
                    );


                artist.className =
                    'small-artist';


                artist.innerText =
                    song.artist
                    ??
                    '';


                nextCard.appendChild(
                    style
                );


                nextCard.appendChild(
                    title
                );


                nextCard.appendChild(
                    artist
                );


                if (
                    index
                    <
                    next.length
                    -
                    1
                ) {

                    const separator =
                        document.createElement(
                            'hr'
                        );


                    nextCard.appendChild(
                        separator
                    );
                }

            }
        );

    }


    /*
     * PROCHAIN CHANGEMENT DE STYLE
     */

    const nextStyleElement =
        document.querySelector(
            '.next-style'
        );


    if (nextStyleElement) {

        nextStyleElement.innerHTML =
            '🕺 Dans '
            +
            String(
                nextStyle.count
                ??
                0
            )
            +
            ' morceaux :'
            +
            '&nbsp;'
            +
            String(
                nextStyle.icon
                ??
                '🟣'
            )
            +
            ' '
            +
            String(
                nextStyle.style
                ??
                'bachata'
            )
            .toUpperCase()
            +
            '&nbsp;'
            +
            '(≈ '
            +
            String(
                nextStyle.minutes
                ??
                0
            )
            +
            ' min)';
    }


    /*
     * SYNCHRONISATION DU TIMER
     */

    if (trackChanged) {

        currentTrackKey =
            newTrackKey;


        duration =
            Number(
                current.duration
                ??
                0
            );


        elapsed =
            Number(
                current.elapsed
                ??
                0
            );


        elapsedAtMeasurement =
            elapsed;


        measuredAt =
            current.measuredAt
            ??
            null;


        measuredTimestamp =
            null;


        if (measuredAt) {

            measuredTimestamp =
                new Date(
                    measuredAt
                ).getTime();


            if (
                Number.isNaN(
                    measuredTimestamp
                )
            ) {

                measuredTimestamp =
                    null;
            }
        }


        refreshProgress();

    }


    /*
     * VÉRIFICATION DU TITRE ET DE L'ARTISTE
     */

    setTimeout(
        function()
        {
            checkTitleOverflow();

            checkArtistOverflow();

        },
        50
    );
}


/*
 * ============================================================
 * RECHARGEMENT DU STATE
 * ============================================================
 */

async function reloadDisplay()
{
    try {

        const response =
            await fetch(
                '{{ path('display_state') }}?_='
                +
                Date.now(),
                {
                    cache:
                        'no-store'
                }
            );


        if (!response.ok) {

            console.warn(
                'Erreur HTTP:',
                response.status
            );

            return;
        }


        const state =
            await response.json();


        updateDisplay(
            state
        );


    } catch (error) {

        console.error(
            'Erreur lors du chargement de l’état:',
            error
        );
    }
}


/*
 * ============================================================
 * POLLING
 * ============================================================
 */

setInterval(
    reloadDisplay,
    1000
);


/*
 * ============================================================
 * HORLOGE
 * ============================================================
 */

function updateClock()
{
    const clock =
        document.querySelector(
            '#clock'
        );


    if (!clock) {
        return;
    }


    const now =
        new Date();


    const hours =
        String(
            now.getHours()
        )
        .padStart(
            2,
            '0'
        );


    const minutes =
        String(
            now.getMinutes()
        )
        .padStart(
            2,
            '0'
        );


    clock.innerText =
        '🕒 '
        +
        hours
        +
        ':'
        +
        minutes;
}


updateClock();


setInterval(
    updateClock,
    1000
);


/*
 * ============================================================
 * CHARGEMENT INITIAL
 * ============================================================
 */

window.addEventListener(
    'load',
    function()
    {
        checkTitleOverflow();

        checkArtistOverflow();

        reloadDisplay();
    }
);

</script>

</body>

</html>