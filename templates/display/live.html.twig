{# templates/display/live.html.twig #}
{% set current = state.current ?? {} %}
{% set previous = state.previous ?? {} %}
{% set next = state.next ?? [] %}
{% set events = state.events ?? [] %}
{% set nextStyle = state.nextStyle ?? {} %}

<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Stras4Water Live</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
:root {
    --accent:#d64040;
    --background:#350909;
    --card:rgba(255,255,255,.08);
    --text:white;
    --muted:rgba(255,255,255,.65);
}

* {
    box-sizing:border-box;
}

html,
body {
    width:100%;
    height:100%;
    margin:0;
    overflow:hidden;
    font-family:Arial, Helvetica, sans-serif;
    color:var(--text);
    background:var(--background);
}

body {
    transition:background-color 1s ease;
}

body.salsa {
    --accent:#d64040;
    --background:#350909;
}

body.bachata {
    --accent:#9b59d8;
    --background:#24102f;
}

body.kizomba {
    --accent:#3b82f6;
    --background:#081b38;
}

.cover-background {
    position:fixed;
    inset:-60px;

    background-image:url('{{ current.cover|default(asset('images/default-cover.jpg')) }}');
    background-size:cover;
    background-position:center;

    filter:blur(50px);
    opacity:.18;
    transform:scale(1.2);
}

.overlay {
    position:fixed;
    inset:0;

    background:
        linear-gradient(
            rgba(0,0,0,.55),
            rgba(0,0,0,.85)
        );
}

.screen {
    position:relative;
    z-index:2;

    height:100vh;

    display:grid;

    grid-template-rows:
        60px
        minmax(0,1fr)
        70px
        180px;

    padding:20px;
    gap:15px;

    overflow:hidden;
}

.header {
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo {
    font-size:clamp(1rem,2vw,1.5rem);
    font-weight:bold;
    letter-spacing:3px;
}

.main {
    display:grid;

    grid-template-columns:
        minmax(0,20%)
        minmax(0,60%)
        minmax(0,20%);

    gap:15px;

    min-height:0;
}

.card {
    min-width:0;

    background:var(--card);

    backdrop-filter:blur(15px);

    border-radius:25px;

    padding:20px;

    overflow:hidden;
}

.side-title {
    color:var(--muted);

    text-transform:uppercase;

    font-size:.85rem;

    margin-bottom:20px;
}

.small-style {
    color:var(--accent);
    font-weight:bold;
}

.small-title {
    margin-top:8px;

    font-size:clamp(1rem,1.3vw,1.3rem);

    font-weight:bold;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;
}

.small-artist {
    color:var(--muted);

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;
}

.current {
    min-width:0;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    background:var(--card);

    backdrop-filter:blur(20px);

    border-radius:30px;
}

.cover {
    width:clamp(150px,15vw,220px);

    height:clamp(150px,15vw,220px);

    object-fit:cover;

    border-radius:20px;

    box-shadow:
        0 20px 50px rgba(0,0,0,.5);
}

.style {
    margin-top:20px;

    font-size:clamp(1.2rem,2vw,2rem);

    font-weight:bold;

    color:var(--accent);
}

.current-title-wrapper {
    width:80%;

    overflow:hidden;

    white-space:nowrap;

    text-align:center;
}

.current-title {
    display:inline-block;

    font-size:clamp(2rem,3vw,3rem);

    font-weight:bold;
}

.current-title.scroll {
    animation:
        marquee 14s linear infinite;
}

@keyframes marquee {
    0%,
    20% {
        transform:translateX(0);
    }

    80%,
    100% {
        transform:translateX(-50%);
    }
}

.artist {
    font-size:clamp(1rem,1.5vw,1.8rem);

    opacity:.75;
}

.progress-container {
    width:75%;

    margin-top:25px;
}

.progress {
    height:12px;

    background:rgba(255,255,255,.2);

    border-radius:20px;

    overflow:hidden;
}

.progress-bar {
    height:100%;

    width:0%;

    background:var(--accent);
}

.time {
    text-align:center;

    margin-top:8px;

    color:var(--muted);
}

.next-style {
    display:flex;

    justify-content:center;

    align-items:center;

    border-left:
        8px solid var(--accent);

    background:var(--card);

    backdrop-filter:blur(15px);

    border-radius:20px;

    font-size:clamp(1rem,2vw,1.8rem);

    font-weight:bold;
}

.bottom {
    display:grid;

    grid-template-columns:
        minmax(0,40%)
        minmax(0,60%);

    gap:15px;
}

.qr {
    display:flex;

    align-items:center;

    gap:25px;
}

.qr img {
    width:110px;

    height:110px;

    background:white;

    padding:10px;

    border-radius:10px;
}

.events {
    padding:15px 20px;
}

.events h2 {
    margin:0 0 10px 0;

    font-size:1.3rem;
}

.events-container {
    height:120px;

    overflow:hidden;
}

.events-list {
    transition:transform 1s ease;
}

.events-list div {
    margin-bottom:8px;

    font-size:1.15rem;
}

.events-list.scrolling {
    animation:
        scrollEvents var(--scroll-duration) linear infinite;
}

@keyframes scrollEvents {
    0%,
    15% {
        transform:translateY(0);
    }

    85%,
    100% {
        transform:translateY(var(--scroll-distance));
    }
}

</style>
</head>

<body class="{{ current.style|default('salsa') }}">

<div class="cover-background"></div>
<div class="overlay"></div>
<div class="screen">

<div class="header">

    <div class="logo">
        <img src="{{ asset('img/logo.png') }}" alt="Logo Stras4Water" height="80">
    </div>

    <div id="clock">
        🕒 21:43
    </div>

</div>

<div class="main">

<div class="card">

    <div class="side-title">
        ✓ Précédente
    </div>

    <div class="small-style">
        {{ previous.icon|default('') }}
        {{ previous.style|default('')|upper }}
    </div>

    <div class="small-title">
        {{ previous.title|default('') }}
    </div>

    <div class="small-artist">
        {{ previous.artist|default('') }}
    </div>

</div>

<div class="current">

{% set hasCurrentTrack = current.title|default('')|trim != '' %}
{% set cover = current.cover ?? asset('images/default-cover.jpg') %}

<img
    class="cover"
    src="{{ cover }}"
    alt="{{ current.title|default('') }}"
    {% if not hasCurrentTrack %}style="visibility:hidden"{% endif %}
>

<div
    class="style"
    {% if not hasCurrentTrack %}style="visibility:hidden"{% endif %}
>
    {{ current.icon|default('') }}
    {{ current.style|default('')|upper }}
</div>

<div class="current-title-wrapper">

    <div
        class="current-title"
        {% if not hasCurrentTrack %}style="visibility:hidden"{% endif %}
    >
        {% if hasCurrentTrack %}
            {{ current.title }}
        {% endif %}
    </div>

</div>

<div
    class="artist"
    {% if not hasCurrentTrack %}style="visibility:hidden"{% endif %}
>
    {% if hasCurrentTrack %}
        {{ current.artist|default('') }}
    {% endif %}
</div>

<div class="progress-container">


    <div class="progress">
        <div class="progress-bar"></div>
    </div>

    <div class="time">
        <span id="elapsed"></span>
        /
        <span id="duration"></span>
    </div>

</div>

</div>

<div class="card">

    <div class="side-title">
        ⏭ Ensuite
    </div>

{% for song in next %}

    <div class="small-style">
        {{ song.icon }}
        {{ song.style|upper }}
    </div>

    <div class="small-title">
        {{ song.title }}
    </div>

    <div class="small-artist">
        {{ song.artist }}
    </div>

    {% if not loop.last %}
        <hr>
    {% endif %}

{% endfor %}

</div>

</div>

<div class="next-style">

    🕺 Dans {{ nextStyle.count|default(2) }} morceaux :

    &nbsp;

    {{ nextStyle.icon|default('🟣') }}

    {{ nextStyle.style|default('bachata')|upper }}

    &nbsp;

    (≈ {{ nextStyle.minutes|default(8) }} min)

</div>

<div class="bottom">

<div class="card qr">

    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={{ absolute_url('/proposer-musique') }}">

    <div>

        <h2>
            📱 Proposer une musique
        </h2>

        Gratuit avec votes

        <br>

        ⚡ Prioritaire pour 2 €

    </div>

</div>

<div class="card events">

    <h2>
        📅 Prochains événements
    </h2>

    <div class="events-container">

        <div class="events-list">

            {% for event in events %}

                <div>
                    {{ event }}
                </div>

            {% endfor %}

        </div>

    </div>

</div>

</div>

</div>

<script>

let elapsed = Number({{ current.elapsed|default(0)|json_encode|raw }});
let duration = Number({{ current.duration|default(1)|json_encode|raw }});
let measuredAt = {{ current.measuredAt|default(null)|json_encode|raw }};

let elapsedAtMeasurement = elapsed;
let measuredTimestamp = null;
let currentTrackKey = null;

if (measuredAt) {
    measuredTimestamp = new Date(measuredAt).getTime();

    if (Number.isNaN(measuredTimestamp)) {
        measuredTimestamp = null;
    }
}

function formatTime(seconds)
{
    seconds = Math.max(
        0,
        Math.floor(Number(seconds) || 0)
    );

    const min = Math.floor(seconds / 60);
    const sec = seconds % 60;

    return min + ':' + String(sec).padStart(2, '0');
}

function getCurrentElapsed()
{
    if (measuredTimestamp !== null) {

        const elapsedNow =
            elapsedAtMeasurement +
            (
                Date.now() -
                measuredTimestamp
            ) / 1000;

        return Math.min(
            duration,
            Math.max(0, elapsedNow)
        );
    }

    return Math.min(
        duration,
        Math.max(0, elapsed)
    );
}

function refreshProgress()
{
    const currentElapsed =
        getCurrentElapsed();

    const progressBar =
        document.querySelector('.progress-bar');

    const elapsedElement =
        document.querySelector('#elapsed');

    const durationElement =
        document.querySelector('#duration');

    if (
        !progressBar ||
        !elapsedElement ||
        !durationElement
    ) {
        return;
    }

    const percentage =
        duration > 0
            ? (currentElapsed / duration) * 100
            : 0;

    progressBar.style.width =
        Math.min(
            100,
            Math.max(0, percentage)
        ) + '%';

    elapsedElement.innerText =
        formatTime(currentElapsed);

    durationElement.innerText =
        formatTime(duration);
}

refreshProgress();

setInterval(
    refreshProgress,
    250
);

function updateDisplay(state)
{
    if (!state || !state.current) {
        return;
    }

    const current = state.current;
    const previous = state.previous || {};
    const next = state.next || [];
    const nextStyle = state.nextStyle || {};

    const newTrackKey =
        String(current.artist ?? '') +
        '|' +
        String(current.title ?? '') +
        '|' +
        String(current.filePath ?? '');

    const trackChanged =
        newTrackKey !== currentTrackKey;

    /*
     * Mise à jour des informations du morceau en cours
     */

    const currentStyle =
        document.querySelector('.style');

    const currentTitle =
        document.querySelector('.current-title');

    const currentArtist =
        document.querySelector('.artist');

    const currentCover =
        document.querySelector('.cover');

    const hasCurrentTrack =
        String(current.title ?? '').trim() !== '';

    if (hasCurrentTrack) {

        if (currentStyle) {
            currentStyle.innerText =
                String(current.icon ?? '') +
                ' ' +
                String(current.style ?? '').toUpperCase();

            currentStyle.style.visibility =
                'visible';
        }

        if (currentTitle) {
            currentTitle.innerText =
                current.title ?? '';

            currentTitle.style.visibility =
                'visible';

            if (trackChanged) {
                currentTitle.classList.remove('scroll');
            }
        }

        if (currentArtist) {
            currentArtist.innerText =
                current.artist ?? '';

            currentArtist.style.visibility =
                'visible';
        }

        if (currentCover && current.cover) {
            currentCover.src =
                current.cover;

            currentCover.alt =
                current.title ?? '';

            currentCover.style.visibility =
                'visible';
        }

    } else {

        /*
        * Aucun morceau en cours
        */

        if (currentStyle) {
            currentStyle.innerText = '';
            currentStyle.style.visibility =
                'hidden';
        }

        if (currentTitle) {
            currentTitle.innerText = '';
            currentTitle.classList.remove('scroll');
            currentTitle.style.visibility =
                'hidden';
        }

        if (currentArtist) {
            currentArtist.innerText = '';
            currentArtist.style.visibility =
                'hidden';
        }

        if (currentCover) {
            currentCover.style.visibility =
                'hidden';
        }
    }

    /*
     * Mise à jour du morceau précédent
     */

    const previousCard =
        document.querySelector(
            '.main > .card:first-child'
        );

    if (previousCard) {

        const previousStyleElement =
            previousCard.querySelector('.small-style');

        const previousTitleElement =
            previousCard.querySelector('.small-title');

        const previousArtistElement =
            previousCard.querySelector('.small-artist');

        if (previousStyleElement) {
            previousStyleElement.innerText =
                String(previous.icon ?? '') +
                ' ' +
                String(previous.style ?? '').toUpperCase();
        }

        if (previousTitleElement) {
            previousTitleElement.innerText =
                previous.title ?? '';
        }

        if (previousArtistElement) {
            previousArtistElement.innerText =
                previous.artist ?? '';
        }
    }

    /*
     * Mise à jour des morceaux suivants
     */

    const nextCard =
        document.querySelector(
            '.main > .card:last-child'
        );

    if (nextCard) {

        const sideTitle =
            nextCard.querySelector('.side-title');

        nextCard.innerHTML = '';

        if (sideTitle) {
            nextCard.appendChild(sideTitle);
        } else {

            const title =
                document.createElement('div');

            title.className =
                'side-title';

            title.innerText =
                '⏭ Ensuite';

            nextCard.appendChild(title);
        }

        next.forEach(function(song, index)
        {
            const style =
                document.createElement('div');

            style.className =
                'small-style';

            style.innerText =
                String(song.icon ?? '') +
                ' ' +
                String(song.style ?? '').toUpperCase();

            const title =
                document.createElement('div');

            title.className =
                'small-title';

            title.innerText =
                song.title ?? '';

            const artist =
                document.createElement('div');

            artist.className =
                'small-artist';

            artist.innerText =
                song.artist ?? '';

            nextCard.appendChild(style);
            nextCard.appendChild(title);
            nextCard.appendChild(artist);

            if (index < next.length - 1) {

                const separator =
                    document.createElement('hr');

                nextCard.appendChild(separator);
            }
        });
    }

    /*
     * Mise à jour du bloc "Dans X morceaux"
     */

    const nextStyleElement =
        document.querySelector('.next-style');

    if (nextStyleElement) {

        nextStyleElement.innerHTML =
            '🕺 Dans ' +
            String(nextStyle.count ?? 0) +
            ' morceaux :' +
            '&nbsp;' +
            String(nextStyle.icon ?? '🟣') +
            ' ' +
            String(nextStyle.style ?? 'bachata').toUpperCase() +
            '&nbsp;' +
            '(≈ ' +
            String(nextStyle.minutes ?? 0) +
            ' min)';
    }

    /*
     * Mise à jour de la synchronisation du morceau
     *
     * On ne recale le timer que lorsqu'on détecte
     * un nouveau morceau.
     */

    if (trackChanged) {

        currentTrackKey =
            newTrackKey;

        duration =
            Number(
                current.duration ?? 0
            );

        elapsed =
            Number(
                current.elapsed ?? 0
            );

        elapsedAtMeasurement =
            elapsed;

        measuredAt =
            current.measuredAt ?? null;

        measuredTimestamp = null;

        if (measuredAt) {

            measuredTimestamp =
                new Date(measuredAt).getTime();

            if (
                Number.isNaN(
                    measuredTimestamp
                )
            ) {
                measuredTimestamp = null;
            }
        }

        refreshProgress();
    }

    /*
     * Vérification du titre défilant
     */

    setTimeout(
        checkTitleOverflow,
        50
    );
}

async function reloadDisplay()
{
    try {

        const response =
            await fetch(
                '{{ path('display_state') }}?_=' +
                Date.now(),
                {
                    cache: 'no-store'
                }
            );

        if (!response.ok) {
            console.warn(
                'Erreur HTTP:',
                response.status
            );

            return;
        }

        const state =
            await response.json();

        updateDisplay(state);

    } catch (error) {

        console.error(
            'Erreur lors du chargement de l’état:',
            error
        );
    }
}

const eventSource =
    new EventSource(
        'http://localhost:5000/events'
    );

eventSource.onmessage =
    function(event)
    {
        console.log(
            '📡 SSE message reçu:',
            event.data
        );

        reloadDisplay();
    };

eventSource.onerror =
    function(error)
    {
        console.warn(
            '⚠️ Connexion SSE interrompue.',
            error
        );
    };

function checkTitleOverflow()
{
    const title =
        document.querySelector(
            '.current-title'
        );

    const wrapper =
        document.querySelector(
            '.current-title-wrapper'
        );

    if (!title || !wrapper) {
        return;
    }

    if (
        title.scrollWidth >
        wrapper.clientWidth
    ) {
        title.classList.add('scroll');
    }
}

function checkEventsOverflow()
{
    const container =
        document.querySelector(
            '.events-container'
        );

    const list =
        document.querySelector(
            '.events-list'
        );

    if (!container || !list) {
        return;
    }

    if (
        list.scrollHeight <=
        container.clientHeight
    ) {
        return;
    }

    const distance =
        container.clientHeight -
        list.scrollHeight;

    list.style.setProperty(
        '--scroll-distance',
        distance + 'px'
    );

    const scrollDuration =
        Math.max(
            15,
            list.children.length * 3
        );

    list.style.setProperty(
        '--scroll-duration',
        scrollDuration + 's'
    );

    list.classList.add('scrolling');
}

window.addEventListener(
    'load',
    function()
    {
        checkTitleOverflow();
        checkEventsOverflow();

        reloadDisplay();
    }
);

function updateClock()
{
    const clock =
        document.querySelector('#clock');

    if (!clock) {
        return;
    }

    const now = new Date();

    const hours =
        String(now.getHours()).padStart(2, '0');

    const minutes =
        String(now.getMinutes()).padStart(2, '0');

    clock.innerText =
        '🕒 ' + hours + ':' + minutes;
}

updateClock();

setInterval(
    updateClock,
    1000
);

</script>

</body>
</html>