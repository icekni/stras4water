{% extends 'base/base_admin.html.twig' %}

{% block title %}Ajouter une carte{% endblock %}

{% block body %}

<h1>
    Ajouter une carte à {{ user.prenom }} {{ user.nom }}
</h1>

{{ form_start(form) }}

    {{ form_row(form.carte) }}
    {{ form_row(form.moyenPaiement) }}
    {{ form_row(form.seancesRestantes) }}

    <button class="btn btn-primary">
        Ajouter la carte
    </button>

{{ form_end(form) }}

{% endblock %}