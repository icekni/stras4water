{% extends 'base/base_admin.html.twig' %}

{% block title %}Scan continu — contrôle d'accès{% endblock %}

{% block style %}
<style>
    /* ---------- Flash visuel au nouveau scan ---------- */
    @keyframes flash-scan {
        0%   { transform: scale(1);    box-shadow: 0 0 0 0 rgba(0,0,0,0); }
        25%  { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(25,135,84,.45); }
        100% { transform: scale(1);    box-shadow: 0 0 0 0 rgba(0,0,0,0); }
    }
    #qr-result.flash > *:first-child { animation: flash-scan .7s ease-out; }

    @keyframes flash-scan-warning {
        0%   { transform: scale(1);    box-shadow: 0 0 0 0 rgba(0,0,0,0); }
        25%  { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(255,193,7,.5); }
        100% { transform: scale(1);    box-shadow: 0 0 0 0 rgba(0,0,0,0); }
    }
    #qr-result.flash-warn > *:first-child { animation: flash-scan-warning .7s ease-out; }
</style>
{% endblock %}

{% block body %}

{# ============================================================
   Layout "une main, un écran" (mobile-first)
   ============================================================ #}
<div class="d-flex flex-column" style="min-height: calc(100vh - 60px);">

    {# Sélecteur de groupe — CIBLE DE L'ANCRE D'ARRIVÉE #}
    <div class="px-2 pt-2" id="scan-top">
        <div class="d-flex align-items-center gap-2">
            <label for="groupe-controle" class="form-label small mb-0 text-nowrap fw-bold">Groupe :</label>
            <select id="groupe-controle" class="form-select form-select-sm">
                <option value="">-- Aucun --</option>
                {% for g in groupes %}
                    <option value="{{ g.id }}">{{ g.nom }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    {# Caméra — compacte et centrée #}
    <div class="px-2 pt-2 text-center">
        <div id="qr-reader" style="width: 220px; height: 220px; margin: 0 auto;"></div>
        <div id="scan-status" class="small mt-1" style="min-height: 1.2rem;">
            Scanner actif — en attente…
        </div>
        <button id="switch-camera" class="btn btn-outline-secondary btn-sm py-0" type="button">
            Changer de caméra
        </button>
    </div>

    {# Résultat : verdict EN HAUT du fragment, détails en dessous #}
    <div class="px-2 pt-2 flex-grow-1" style="overflow-y: auto;">
        <div id="qr-result">
            <div class="text-muted text-center p-2 small">
                Aucun QR scanné pour l'instant.<br>
                Les contrôles d'accès s'afficheront ici.
            </div>
        </div>
    </div>

</div>

{# Retour discret #}
<div class="px-3 pb-2">
    <a href="{{ path('admin_user_index') }}" class="btn btn-link btn-sm text-secondary p-0">
        ← Retour à la liste
    </a>
</div>

<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<script>
let html5QrCode;
let camerasList = [];
let currentCameraIndex = 0;

let busy = false;            // true pendant le fetch d'un résultat
let lastScanned = null;      // dernier QR décodé
let lastScannedAt = 0;       // timestamp du dernier scan
const COOLDOWN_MS = 3000;    // même QR ignoré pendant 3 s
const REARM_MS = 1500;       // réarmement du scanner après un scan
const FETCH_TIMEOUT_MS = 8000;  // abandon du fetch au bout de 8 s
const RETRY_DELAY_MS = 1500;    // pause avant le retry auto
const MAX_RETRIES = 2;           // 1er essai + 2 retries

const groupeSelect = document.getElementById('groupe-controle');
const qrResult = document.getElementById('qr-result');
const scanStatus = document.getElementById('scan-status');

/**
 * URL du fragment de contrôle.
 */
function getFragmentUrl(decodedText) {
    let url = "{{ path('admin_user_scan_fragment', {'hexId': 'ID_REPLACE'}) }}"
        .replace('ID_REPLACE', encodeURIComponent(decodedText));
    if (groupeSelect.value) {
        url += '?groupe=' + encodeURIComponent(groupeSelect.value);
    }
    return url;
}

/**
 * FEEDBACK NOUVEAU SCAN — flash, vibration, bip.
 */
let audioCtx = null;
function beep(frequency = 880, duration = 0.12, pattern = 1) {
    try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        for (let i = 0; i < pattern; i++) {
            const t = audioCtx.currentTime + i * (duration + 0.09);
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'square';
            osc.frequency.value = frequency;
            gain.gain.setValueAtTime(0.18, t);
            gain.gain.exponentialRampToValueAtTime(0.001, t + duration);
            osc.connect(gain).connect(audioCtx.destination);
            osc.start(t);
            osc.stop(t + duration);
        }
    } catch (e) { console.warn('bip indisponible', e); }
}

let userInteracted = false;
['pointerdown', 'touchstart', 'click'].forEach(evt =>
    window.addEventListener(evt, () => { userInteracted = true; }, { once: true, passive: true })
);

function vibrate(verdict) {
    if (!navigator.vibrate || !userInteracted) return;
    if (verdict === 'ok')          navigator.vibrate(80);
    else if (verdict === 'refuse') navigator.vibrate([200, 100, 200]);
    else                           navigator.vibrate([120, 80, 120]);
}

function beepVerdict(verdict) {
    if (verdict === 'ok')          beep(880, 0.12, 1);   // un bip aigu court
    else if (verdict === 'refuse') beep(220, 0.25, 2);   // deux bips graves
    else if (verdict === 'consult') beep(660, 0.10, 1);  // un bip neutre
    else if (verdict === 'network') beep(520, 0.14, 3);  // trois bips médiums = problème réseau
    else                           beep(520, 0.14, 2);
}

function flashVerdict(warn = false) {
    qrResult.classList.remove('flash', 'flash-warn');
    void qrResult.offsetWidth; // retrigger de l'animation CSS
    qrResult.classList.add(warn ? 'flash-warn' : 'flash');
}

function feedback(verdict) {
    vibrate(verdict);
    beepVerdict(verdict);
    flashVerdict(verdict === 'network' || verdict === 'session');
}

/**
 * Détermine le verdict depuis le fragment HTML injecté (data attribute).
 * Retourne null si le fragment ne contient PAS de data-verdict :
 * ce n'est pas un fragment de contrôle valide (ex : page de login
 * renvoyée après expiration de session) → à traiter comme une erreur,
 * jamais comme un "ok" par défaut.
 */
function readVerdict() {
    const el = qrResult.querySelector('[data-verdict]');
    return el ? el.getAttribute('data-verdict') : null;
}

/**
 * Affiche une erreur réseau SANS écraser le dernier utilisateur,
 * pour que le bénévole garde le contexte du scan en échec.
 * Le bandeau s'insère AU-DESSUS du fragment conservé.
 */
function showNetworkError(message, retryFn) {
    // Si un bandeau d'erreur précédent existe déjà, le retirer
    document.getElementById('net-error-banner')?.remove();

    const banner = document.createElement('div');
    banner.id = 'net-error-banner';
    banner.className = 'alert alert-warning text-center mb-2 py-2';
    banner.innerHTML = `
        <strong>📡 ${message}</strong><br>
        <span class="small">Le dernier scan n'a pas été compté comme refusé.</span>
        <button type="button" class="btn btn-sm btn-warning mt-2" id="net-retry-btn">🔄 Réessayer</button>
    `;

    qrResult.prepend(banner);
    banner.querySelector('#net-retry-btn').addEventListener('click', () => {
        banner.remove();
        if (typeof retryFn === 'function') retryFn();
    });
}

function removeNetworkBanner() {
    document.getElementById('net-error-banner')?.remove();
}

/**
 * Charge et affiche le résultat d'un scan.
 * — timeout explicite + retries automatiques pour les micro-coupures wifi
 * — erreur réseau → bandeau dédié, JAMAIS un verdict "refuse"
 * — session expirée (redirect login avec statut 200) → message clair
 */
async function handleScan(decodedText, attempt = 0) {
    busy = true;
    scanStatus.innerText = '⏳ Vérification en cours…'
        + (attempt > 0 ? ' (tentative ' + (attempt + 1) + ')' : '');

    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);

    try {
        const res = await fetch(getFragmentUrl(decodedText), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            signal: controller.signal
        });

        // QR INCONNU : on IGNORE — pas de bip "refusé" mensonger.
        if (res.status === 404) {
            scanStatus.innerText = '⚠️ QR code inconnu — ignoré.';
            busy = false;
            return;
        }

        // 403 : session expirée (le firewall redirige parfois en 302→login,
        // mais un access denied direct arrive aussi). À distinguer d'un refus :
        // le refus métier arrive en 200 avec data-verdict="refuse".
        if (res.status === 403) {
            showSessionExpired();
            busy = false;
            return;
        }

        if (!res.ok) throw new Error('HTTP ' + res.status);

        const html = await res.text();
        clearTimeout(timer);

        // Le fetch suit les redirections : si la session a expiré, on reçoit
        // la page de LOGIN (statut 200) au lieu du fragment. Détection :
        // pas de data-verdict dans le HTML reçu.
        qrResult.innerHTML = html;
        const verdict = readVerdict();

        if (verdict === null) {
            showSessionExpired();
            busy = false;
            return;
        }

        // Fragment valide : retirer un éventuel bandeau réseau précédent
        removeNetworkBanner();
        feedback(verdict);
        scanStatus.innerText = '✅ Scanné — prêt pour la prochaine carte.';

    } catch (e) {
        clearTimeout(timer);

        // Retry automatique (timeout / micro-coupure wifi) avant d'annoncer
        // l'erreur — la majorité des échecs réseau passent au 2e essai.
        if (attempt < MAX_RETRIES - 1) {
            scanStatus.innerText = '⏳ Connexion instable — nouvel essai…';
            setTimeout(() => handleScan(decodedText, attempt + 1), RETRY_DELAY_MS);
            return; // busy reste true : pas de double-scan pendant le retry
        }

        // Vraie erreur réseau après retries :
        // - PAS de verdict "refuse" (le serveur n'a rien dit)
        // - le dernier utilisateur reste affiché dessous, contexte conservé
        console.error(e);
        showNetworkError('Réseau indisponible', () => handleScan(decodedText));
        feedback('network'); // flash jaune + bip distinctif, pas rouge
        scanStatus.innerText = '📡 Réseau indisponible — bouton Réessayer affiché.';

    } finally {
        clearTimeout(timer);
        // Réarmement (sauf si un retry est en cours : géré dans le catch)
        setTimeout(() => { busy = false; }, REARM_MS);
    }
}

/**
 * Session expirée : cas très fréquent après ~1h de scan.
 * Message explicite + bouton de reconnexion (la page de scan
 * doit être rechargée après re-login pour retrouver le contexte).
 */
function showSessionExpired() {
    document.getElementById('net-error-banner')?.remove();

    const banner = document.createElement('div');
    banner.id = 'net-error-banner';
    banner.className = 'alert alert-danger text-center mb-2 py-2';
    banner.innerHTML = `
        <strong>🔒 Session expirée</strong><br>
        <span class="small">Reconnecte-toi pour continuer le contrôle d'accès.</span>
        <div class="mt-2">
            <a href="{{ path('app_login') }}" class="btn btn-sm btn-danger">Se reconnecter</a>
        </div>
    `;
    qrResult.prepend(banner);
    feedback('session');
    scanStatus.innerText = '🔒 Session expirée — reconnexion nécessaire.';
}

/**
 * Intercepte les formulaires du fragment (Déduire 1 séance / Vérifier justificatif).
 */
qrResult.addEventListener('submit', async function (e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button');
    if (btn) { btn.disabled = true; btn.innerText = '…'; }

    if (form.dataset.confirm && !confirm(form.dataset.confirm)) {
        if (btn) { btn.disabled = false; btn.innerText = form.dataset.label || 'OK'; }
        return;
    }

    try {
        const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        qrResult.innerHTML = await res.text();
    } catch (e) {
        console.error(e);
        alert('Erreur lors de l\'action. Rechargez la page.');
        if (btn) btn.disabled = false;
    }
});

/**
 * Démarre le scanner (jamais arrêté par un scan réussi).
 */
function startScanner(cameraIndex = 0) {
    html5QrCode = new Html5Qrcode("qr-reader");

    Html5Qrcode.getCameras().then(cameras => {
        if (!cameras || !cameras.length) {
            alert("Aucune caméra détectée.");
            return;
        }
        camerasList = cameras;

        if (cameraIndex === 0) {
            let rearCamera = cameras.find(cam =>
                cam.label.toLowerCase().includes('back') ||
                cam.label.toLowerCase().includes('rear')
            );
            currentCameraIndex = rearCamera ? cameras.indexOf(rearCamera) : 0;
        } else {
            currentCameraIndex = cameraIndex % cameras.length;
        }

        html5QrCode.start(
            camerasList[currentCameraIndex].id,
            { fps: 10, qrbox: { width: 240, height: 240 }, aspectRatio: 1.0, rememberLastUsedCamera: true },
            decodedText => {
                const now = Date.now();

                if (decodedText === lastScanned && (now - lastScannedAt) < COOLDOWN_MS) {
                    return;
                }
                if (busy) {
                    return;
                }

                lastScanned = decodedText;
                lastScannedAt = now;

                handleScan(decodedText);
            },
            () => { /* erreurs de lecture ignorées */ }
        ).catch(err => console.error("Erreur démarrage scanner :", err));

    }).catch(err => console.error("Erreur récupération caméras :", err));
}

groupeSelect.addEventListener('change', () => {
    scanStatus.innerText = 'Scanner actif — en attente d\u2019un QR code…';
});

document.getElementById('switch-camera').addEventListener('click', () => {
    if (!camerasList.length || !html5QrCode) return;
    html5QrCode.stop().then(() => {
        currentCameraIndex = (currentCameraIndex + 1) % camerasList.length;
        startScanner(currentCameraIndex);
    });
});

// Surveiller la connectivité : bannière dès que le device passe offline,
// pour prévenir AVANT le prochain scan raté.
window.addEventListener('offline', () => {
    showNetworkError('Appareil hors ligne (Wi-Fi/4G perdu)', null);
    scanStatus.innerText = '📡 Hors ligne — reconnexion en cours…';
});
window.addEventListener('online', () => {
    removeNetworkBanner();
    scanStatus.innerText = '✅ Connexion rétablie — scanner prêt.';
});

window.addEventListener('DOMContentLoaded', () => {
    startScanner();

    setTimeout(() => {
        document.getElementById('scan-top')?.scrollIntoView({ block: 'start' });
    }, 100);
});
</script>

{% endblock %}