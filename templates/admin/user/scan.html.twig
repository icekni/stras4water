{% extends 'base/base_admin.html.twig' %}

{% block title %}Scanner QR Code Utilisateur{% endblock %}

{% block body %}
<h1>Scanner QR Code utilisateur</h1>

<p>Placez le QR code devant la caméra de votre smartphone.</p>

<div id="qr-reader" style="width: 100%; max-width: 400px; margin: auto;"></div>
<div id="qr-result" style="margin-top: 1rem;"></div>

<!-- Inclure la librairie HTML5 QR Code -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/minified/html5-qrcode.min.js"></script>
<script>
    function onScanSuccess(decodedText, decodedResult) {
        // decodedText = contenu du QR code (ex: ID de l'utilisateur)
        console.log(`QR Code détecté : ${decodedText}`);
        document.getElementById('qr-result').innerText = "Utilisateur détecté : " + decodedText;

        // Redirection vers la route check
        window.location.href = "{{ path('admin_user_scan_id', {'id': 'ID_REPLACE'}) }}".replace('ID_REPLACE', decodedText);
    }

    function onScanFailure(error) {
        // Ignorer les erreurs de lecture
    }

    let html5QrcodeScanner = new Html5QrcodeScanner(
        "qr-reader", { fps: 10, qrbox: 250 }
    );
    html5QrcodeScanner.render(onScanSuccess, onScanFailure);
</script>
{% endblock %}