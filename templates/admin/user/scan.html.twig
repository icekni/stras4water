{% extends 'base/base_admin.html.twig' %}

{% block title %}Scanner QR Code Utilisateur{% endblock %}

{% block body %}
<h1>Scanner QR Code utilisateur</h1>

<p>
    Sélectionnez le groupe de contrôle à utiliser pour le contrôle,
    puis placez le QR code devant la caméra.
</p>

<div class="mb-4" style="max-width: 500px;">
    <label for="groupe-controle" class="form-label">
        Groupe de contrôle
    </label>

    <select id="groupe-controle" class="form-select">
        <option value="">-- Sélectionner un groupe --</option>

        {% for groupe in groupes %}
            <option value="{{ groupe.id }}">
                {{ groupe.nom }}
            </option>
        {% endfor %}
    </select>

    <div id="groupe-warning" class="text-danger mt-2 d-none">
        Veuillez sélectionner un groupe de contrôle avant de scanner un QR code.
    </div>
</div>

<div style="display: flex; flex-direction: row; gap: 2rem; flex-wrap: wrap;">

    <!-- Bouton changement de caméra -->
    <div style="flex-basis: 100%; margin-bottom: 1rem;">
        <button
            id="switch-camera"
            class="btn btn-outline-secondary"
            type="button"
        >
            Changer de caméra
        </button>
    </div>

    <!-- Carré caméra / scanner -->
    <div
        id="qr-reader"
        style="width: 300px; height: 300px; border: 2px solid #333;"
    ></div>

    <!-- Zone résultat -->
    <div style="flex: 1;">
        <h3>QR Code détecté :</h3>

        <div
            id="qr-result"
            style="padding: 1rem; border: 1px solid #ccc; min-height: 50px;"
        >
            Aucun QR détecté
        </div>

        <button
            id="reset-scanner"
            class="btn btn-outline-primary mt-2"
            type="button"
        >
            Scanner à nouveau
        </button>
    </div>
</div>

<a href="{{ path('admin_user_index') }}" class="btn btn-secondary mt-3">
    ← Retour à la liste
</a>

<!-- Librairie -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

<script>
let html5QrCode;
let scanning = false;
let camerasList = [];
let currentCameraIndex = 0;

const groupeSelect = document.getElementById('groupe-controle');
const groupeWarning = document.getElementById('groupe-warning');
const qrResult = document.getElementById('qr-result');

/**
 * Retourne l'URL de scan avec le groupe sélectionné.
 */
function getScanUrl(decodedText) {
    const groupeId = groupeSelect.value;

    let url = "{{ path('admin_user_scan_id', {'hexId': 'ID_REPLACE'}) }}"
        .replace('ID_REPLACE', encodeURIComponent(decodedText));

    if (groupeId) {
        url += '?groupe=' + encodeURIComponent(groupeId);
    }

    return url;
}

/**
 * Vérifie qu'un groupe est sélectionné.
 */
function hasSelectedGroup() {
    if (!groupeSelect.value) {
        groupeWarning.classList.remove('d-none');
        groupeSelect.focus();

        return false;
    }

    groupeWarning.classList.add('d-none');

    return true;
}

function startScanner(cameraIndex = 0) {

    html5QrCode = new Html5Qrcode("qr-reader");

    Html5Qrcode.getCameras().then(cameras => {
        if (cameras && cameras.length) {
            camerasList = cameras;

            // Recherche caméra arrière si index 0
            if (cameraIndex === 0) {
                let rearCamera = cameras.find(cam =>
                    cam.label.toLowerCase().includes('back') ||
                    cam.label.toLowerCase().includes('rear')
                );

                currentCameraIndex = rearCamera
                    ? cameras.indexOf(rearCamera)
                    : 0;
            } else {
                currentCameraIndex = cameraIndex % cameras.length;
            }

            const cameraId = camerasList[currentCameraIndex].id;
            scanning = true;

            html5QrCode.start(
                cameraId,
                {
                    fps: 10,
                    qrbox: 250,
                    aspectRatio: 1.0,
                    rememberLastUsedCamera: true
                },
                decodedText => {
                    if (!scanning) {
                        return;
                    }

                    if (!hasSelectedGroup()) {
                        return;
                    }

                    scanning = false;
                    qrResult.innerText = decodedText;

                    html5QrCode.stop().then(() => {
                        window.location.href = getScanUrl(decodedText);
                    }).catch(err => {
                        console.error("Erreur arrêt scanner :", err);
                    });
                },
                errorMessage => {
                    // Erreurs de lecture ignorées
                }
            ).catch(err => {
                console.error("Erreur démarrage scanner :", err);
            });

        } else {
            alert("Aucune caméra détectée.");
        }

    }).catch(err => {
        console.error("Erreur récupération caméras :", err);
    });
}


// Changement de groupe
groupeSelect.addEventListener('change', function() {
    groupeWarning.classList.add('d-none');
});


// Bouton "Scanner à nouveau"
document.getElementById('reset-scanner').addEventListener('click', function() {
    if (!hasSelectedGroup()) {
        return;
    }

    if (html5QrCode) {
        html5QrCode.stop().then(() => {
            qrResult.innerText = "Aucun QR détecté";
            scanning = false;
            startScanner(currentCameraIndex);
        }).catch(err => {
            console.error("Erreur arrêt scanner :", err);
        });
    } else {
        startScanner(currentCameraIndex);
    }
});


// Bouton "Changer de caméra"
document.getElementById('switch-camera').addEventListener('click', function() {
    if (!hasSelectedGroup()) {
        return;
    }

    if (!camerasList.length || !html5QrCode) {
        return;
    }

    html5QrCode.stop().then(() => {
        currentCameraIndex =
            (currentCameraIndex + 1) % camerasList.length;

        startScanner(currentCameraIndex);
    }).catch(err => {
        console.error("Erreur arrêt scanner :", err);
    });
});


// Démarrage initial
window.addEventListener('DOMContentLoaded', () => {
    startScanner();
});
</script>
{% endblock %}