{% extends 'base/base_admin.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<h1>Utilisateurs</h1>

<a href="{{ path('admin_inscription_new') }}" class="btn btn-primary mb-3">Ajouter un utilisateur</a>


{% if is_granted('ROLE_ADMIN') %}
<a class="btn btn-primary mb-3 btn-success" href="{{ path('admin_user_export') }}">
    Exporter les adherents (.csv)
</a>
{% endif %}

<!-- Champ de recherche -->
<div class="mb-3">
    <input type="text" id="searchInput" class="form-control" value="{{ search }}" placeholder="Rechercher par nom, prénom ou email...">
</div>

<!-- Version desktop : tableau -->
<div class="table-responsive d-none d-md-block">
    <table class="table table-bordered table-striped align-middle" id="usersTable">
        <thead>
            <tr>
                <th>Nom & Prénom</th>
                <th>Email</th>
                <th>Adhérent</th>
                <th>Abonnements & Cartes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr data-nom="{{ user.nom }}" data-prenom="{{ user.prenom }}" data-email="{{ user.email }}">
                <td>{{ user.nom }} {{ user.prenom }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {{ user.adhesion ? '✔️' : '❌' }}
                </td>
                <td>
                    {% set hasAbonnement = false %}
                    {% for ab in user.abonnementSouscrits %}
                        {% if ab.statut != constant('App\\Enum\\Statut::CREATED') %}
                            <div>
                                {{ ab.abonnement.nom }}
                                {% if ab.isTarifReduit and not ab.tarifReduitVerifie %}
                                    <form
                                        method="post"
                                        action="{{ path('admin_abonnement_verifier', {
                                            id: ab.id
                                        }) }}"
                                        class="d-inline"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-success"
                                        >
                                            Vérifier le justificatif
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                            {% set hasAbonnement = true %}
                        {% endif %}
                    {% endfor %}
                    {% for c in user.carteSouscrites %}
                        {% if c.statut != constant('App\\Enum\\Statut::CREATED') %}
                            <div>
                                {{ c.carte.nom }} — Séances restantes: {{ c.seancesRestantes }}
                                <form method="post"
                                    action="{{ path('admin_carte_retirer_seance', {id: c.id}) }}">
                                    <input type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('retirer_seance' ~ c.id) }}">

                                    <input type="hidden" name="groupe" value="{{ groupe.id }}">

                                    <button type="submit" class="btn btn-warning">
                                        Retirer une séance
                                    </button>
                                </form>
                                {% if c.isTarifReduit and not c.tarifReduitVerifie %}
                                    <a href="{{ path('admin_carte_verifier', {id: c.id}) }}" 
                                    class="btn btn-sm btn-success ms-1">Vérifier</a>
                                {% endif %}
                            </div>
                            {% set hasAbonnement = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not hasAbonnement %}
                        <span class="text-muted">Aucun en cours</span>
                    {% endif %}
                </td>
                <td>
                    <div class="d-flex flex-column gap-2">

                        {# Actions principales #}
                        <a
                            href="{{ path('admin_user_inscription', {'id': user.id}) }}"
                            class="btn btn-sm btn-primary"
                        >
                            ➕ Ajouter une activité
                        </a>

                        <a
                            href="{{ path('admin_user_edit', {'id': user.id}) }}"
                            class="btn btn-sm btn-outline-secondary"
                        >
                            ✏️ Modifier
                        </a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <form
                                method="post"
                                action="{{ path('admin_user_delete', {id: user.id}) }}"
                                onsubmit="return confirm('Confirmer la suppression de cet utilisateur ?');"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_user_' ~ user.id) }}"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-danger w-100"
                                >
                                    🗑️ Supprimer
                                </button>
                            </form>
                        {% endif %}

                        {# Carte de membre #}
                        {% if user.adhesion %}
                            <div class="border rounded p-2 mt-2 bg-light">
                                <div class="small fw-semibold text-muted mb-2">
                                    Carte de membre
                                </div>

                                <div class="d-flex flex-wrap gap-2">

                                    <a
                                        href="{{ asset('cartesMembre/' ~ user.id ~ '.pdf') }}"
                                        class="btn btn-sm btn-outline-info"
                                        target="_blank"
                                        download="carte-adhesion-{{ user.nom }}-{{ user.prenom }}.pdf"
                                    >
                                        📄 Télécharger
                                    </a>

                                    <form
                                        method="post"
                                        action="{{ path('admin_user_send_card', {id: user.id}) }}"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('send_card_' ~ user.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-info"
                                            onclick="return confirm('Envoyer la carte de membre à {{ user.email }} ?');"
                                        >
                                            📧 Envoyer
                                        </button>
                                    </form>

                                </div>

                                <form
                                    method="post"
                                    action="{{ path('admin_user_regenerate_card', {id: user.id}) }}"
                                    class="mt-2"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('regenerate_card_' ~ user.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-link text-warning px-0"
                                    >
                                        🔄 Régénérer la carte
                                    </button>
                                </form>
                            </div>
                        {% endif %}

                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">Aucun utilisateur.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

<!-- Version mobile : cartes -->
<div class="d-block d-md-none" id="usersCards">
    {% for user in users %}
        <div class="card mb-2 shadow-sm" data-nom="{{ user.nom }}" data-prenom="{{ user.prenom }}" data-email="{{ user.email }}">
            <div class="card-body">
                <h5 class="card-title">{{ user.nom }} {{ user.prenom }}</h5>
                <p class="mb-1"><strong>Email:</strong> {{ user.email }}</p>
                <p class="mb-1"><strong>Adhérent:</strong> {{ user.adhesion ? '✔️' : '❌' }}</p>

                <p class="mb-1"><strong>Abonnements & Cartes:</strong>
                    {% set hasAbonnement = false %}
                    {% for ab in user.abonnementSouscrits %}
                        <div>
                            {{ ab.abonnement.nom }}
                            {% if ab.isTarifReduit and not ab.tarifReduitVerifie %}
                                <a href="{{ path('admin_abonnement_verifier', {id: ab.id}) }}" 
                                   class="btn btn-sm btn-success ms-1">Vérifier</a>
                            {% endif %}
                        </div>
                        {% set hasAbonnement = true %}
                    {% endfor %}
                    {% for c in user.carteSouscrites %}
                        <div>
                            {{ c.carte.nom }} — Séances restantes: {{ c.seancesRestantes }}
                            <form method="post"
                                action="{{ path('admin_carte_retirer_seance', {id: c.id}) }}">
                                <input type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('retirer_seance' ~ c.id) }}">

                                <input type="hidden" name="groupe" value="{{ groupe.id }}">

                                <button type="submit" class="btn btn-warning">
                                    Retirer une séance
                                </button>
                            </form>
                            {% if c.isTarifReduit and not c.tarifReduitVerifie %}
                                <a href="{{ path('admin_carte_verifier', {id: c.id}) }}" 
                                   class="btn btn-sm btn-success ms-1 mb-1">Vérifier</a>
                            {% endif %}
                        </div>
                        {% set hasAbonnement = true %}
                    {% endfor %}
                    {% if not hasAbonnement %}
                        <span class="text-muted">Aucun en cours</span>
                    {% endif %}
                </p>

                <div class="mt-2">

                    <div class="d-grid gap-2">

                        {# Actions principales #}
                        <a
                            href="{{ path('admin_user_inscription', {'id': user.id}) }}"
                            class="btn btn-sm btn-primary"
                        >
                            ➕ Ajouter une activité
                        </a>

                        <a
                            href="{{ path('admin_user_edit', {'id': user.id}) }}"
                            class="btn btn-sm btn-outline-secondary"
                        >
                            ✏️ Modifier
                        </a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <form
                                method="post"
                                action="{{ path('admin_user_delete', {id: user.id}) }}"
                                onsubmit="return confirm('Confirmer la suppression de cet utilisateur ?');"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete_user_' ~ user.id) }}"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-danger w-100"
                                >
                                    🗑️ Supprimer
                                </button>
                            </form>
                        {% endif %}

                    </div>

                    {# Carte de membre #}
                    {% if user.adhesion %}
                        <div class="border rounded p-3 mt-3 bg-light">

                            <div class="fw-semibold mb-2">
                                Carte de membre
                            </div>

                            <div class="d-grid gap-2">

                                <a
                                    href="{{ asset('cartesMembre/' ~ user.id ~ '.pdf') }}"
                                    class="btn btn-sm btn-outline-info"
                                    target="_blank"
                                    download="carte-adhesion-{{ user.nom }}-{{ user.prenom }}.pdf"
                                >
                                    📄 Télécharger la carte
                                </a>

                                <form
                                    method="post"
                                    action="{{ path('admin_user_send_card', {id: user.id}) }}"
                                >
                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('send_card_' ~ user.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-info w-100"
                                        onclick="return confirm('Envoyer la carte de membre à {{ user.email }} ?');"
                                    >
                                        📧 Envoyer par email
                                    </button>
                                </form>

                            </div>

                            <form
                                method="post"
                                action="{{ path('admin_user_regenerate_card', {id: user.id}) }}"
                                class="mt-2"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('regenerate_card_' ~ user.id) }}"
                                >

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-link text-warning px-0"
                                >
                                    🔄 Régénérer la carte
                                </button>
                            </form>

                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    {% else %}
        <p>Aucun utilisateur.</p>
    {% endfor %}
</div>

{% endblock %}

{% block javascripts %}
<script>
function normalize(str) {
    return str.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
}

// Algorithme simple Soundex JS
function soundex(s) {
    if (!s) return "";
    s = s.toUpperCase().replace(/[^A-Z]/g, "");
    const a = s.split("");
    const f = a.shift();
    const codes = {B:1,F:1,P:1,V:1,C:2,G:2,J:2,K:2,Q:2,S:2,X:2,Z:2,D:3,T:3,L:4,M:5,N:5,R:6};
    const result = [f];
    let prev = codes[f] || 0;
    for (let c of a) {
        const code = codes[c] || 0;
        if (code !== prev && code !== 0) result.push(code);
        prev = code;
    }
    return (result.join("") + "000").slice(0,4);
}

// Levenshtein distance
function levenshtein(a, b) {
    const al = a.length, bl = b.length;
    if (al === 0) return bl;
    if (bl === 0) return al;
    let matrix = [];
    for (let i=0;i<=bl;i++){matrix[i]=[i];}
    for (let j=0;j<=al;j++){matrix[0][j]=j;}
    for (let i=1;i<=bl;i++){
        for (let j=1;j<=al;j++){
            const cost = (b[i-1]===a[j-1])?0:1;
            matrix[i][j] = Math.min(
                matrix[i-1][j]+1,
                matrix[i][j-1]+1,
                matrix[i-1][j-1]+cost
            );
        }
    }
    return matrix[bl][al];
}

document.getElementById("searchInput").addEventListener("input", function() {
    const term = normalize(this.value);
    if (term.length < 3) {
        document.querySelectorAll("#usersTable tbody tr").forEach(tr => tr.style.display="");
        document.querySelectorAll("#usersCards .card").forEach(card => card.style.display="");
        return;
    }

    document.querySelectorAll("#usersTable tbody tr").forEach(tr => {
        const nom = normalize(tr.dataset.nom);
        const prenom = normalize(tr.dataset.prenom);
        const email = normalize(tr.dataset.email);

        const match = [nom, prenom, email].some(str => {
            const sdxTerm = soundex(term);
            const sdxStr = soundex(str);
            return str.includes(term) || levenshtein(term,str)<=2 || sdxTerm===sdxStr;
        });

        tr.style.display = match ? "" : "none";
    });

    document.querySelectorAll("#usersCards .card").forEach(card => {
        const nom = normalize(card.dataset.nom);
        const prenom = normalize(card.dataset.prenom);
        const email = normalize(card.dataset.email);

        const match = [nom, prenom, email].some(str => {
            const sdxTerm = soundex(term);
            const sdxStr = soundex(str);
            return str.includes(term) || levenshtein(term,str)<=2 || sdxTerm===sdxStr;
        });

        card.style.display = match ? "" : "none";
    });
});

const searchInput = document.getElementById("searchInput");
if (searchInput.value.trim() !== "") {
    searchInput.dispatchEvent(new Event("input"));
}
</script>
{% endblock %}
