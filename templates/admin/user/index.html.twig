{% extends 'base/base_admin.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <h1>Utilisateurs</h1>

    <a href="{{ path('admin_user_new') }}" class="btn btn-primary mb-3">Ajouter un utilisateur</a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Nom & Prénom</th>
                <th>Email</th>
                <th>Adhérent</th>
                <th>Abonnements & Cartes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.nom }} {{ user.prenom }}</td>
                <td>{{ user.email }}</td>

                <td>
                    {{ user.isAdherent ? '✔️' : '❌' }}
                </td>

                <td>
                    {% set listeVide = true %}
                    {% for abonnementSouscrit in user.abonnementSouscrits %}
                        {% set listeVide = false %}
                        <div>{{ abonnementSouscrit.abonnement.nom }}</div>
                    {% endfor %}
                    {% for carteSouscrite in user.carteSouscrites %}
                        {% set listeVide = false %}
                        <div>{{ carteSouscrite.carte.nom }}</div>
                    {% endfor %}
                    {% if listeVide %}
                        <span class="text-muted">Aucun en cours</span>
                    {% endif %}
                </td>

                <td>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    {# <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button class="btn btn-sm btn-danger">Supprimer</button>
                    </form> #}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun utilisateur.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
