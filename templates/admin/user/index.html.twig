{% extends 'base/base_admin.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<h1>Utilisateurs</h1>

<a href="{{ path('admin_inscription_new') }}" class="btn btn-primary mb-3">Ajouter un utilisateur</a>

{% if is_granted('ROLE_ADMIN') %}
<a class="btn btn-primary mb-3 btn-success" href="{{ path('admin_user_export') }}">
    Exporter les adherents (.csv)
</a>
{% endif %}

{# ================================================================ #}
{# Recherche (toujours visible, ligne dédiée)                        #}
{# ================================================================ #}
<div class="mb-3">
    <input type="text" id="searchInput" class="form-control" value="{{ search }}"
           placeholder="Rechercher par nom, prénom ou email...">
</div>

{# ================================================================ #}
{# Bouton d'ouverture des filtres (repliés par défaut)              #}
{# ================================================================ #}
<div class="mb-2 d-flex align-items-center gap-2">
    <button class="btn btn-outline-secondary btn-sm" type="button"
            data-bs-toggle="collapse" data-bs-target="#filtersPanel"
            aria-expanded="false" aria-controls="filtersPanel">
        🎛️ Filtres
        <span id="filtersCount" class="badge bg-primary d-none ms-1">0</span>
    </button>

    <span id="resultsCount" class="text-muted small">
        <strong>{{ users|length }}</strong> utilisateur{{ users|length > 1 ? 's' : '' }}
    </span>
</div>

<div class="collapse" id="filtersPanel">
    <div class="card card-body mb-3">
        <div class="row g-2">
            <div class="col-12 col-md-3">
                <div class="border rounded p-2 filter-group" data-filter="discipline" style="max-height:110px; overflow-y:auto;">
                    <div class="small fw-semibold text-muted mb-1">Disciplines</div>
                    {% for d in disciplines %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="{{ d.id }}" id="disc_{{ d.id }}">
                            <label class="form-check-label" for="disc_{{ d.id }}">{{ d.nom }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col-12 col-md-3">
                <div class="border rounded p-2 filter-group" data-filter="abonnement" style="max-height:110px; overflow-y:auto;">
                    <div class="small fw-semibold text-muted mb-1">Abonnements</div>
                    {% for a in abonnements %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="{{ a.id }}" id="abo_{{ a.id }}">
                            <label class="form-check-label" for="abo_{{ a.id }}">{{ a.nom }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col-12 col-md-3">
                <div class="border rounded p-2 filter-group" data-filter="carte" style="max-height:110px; overflow-y:auto;">
                    <div class="small fw-semibold text-muted mb-1">Cartes</div>
                    {% for c in cartes %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="{{ c.id }}" id="carte_{{ c.id }}">
                            <label class="form-check-label" for="carte_{{ c.id }}">{{ c.nom }}</label>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="col-6 col-md-1">
                <select id="filterAdhesion" class="form-select">
                    <option value="">Adhésion</option>
                    <option value="1">Adhérents</option>
                    <option value="0">Non adhérents</option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select id="filterTarif" class="form-select">
                    <option value="">Tarif</option>
                    <option value="1">Tarif réduit</option>
                    <option value="0">Tarif plein</option>
                </select>
            </div>

            <div class="col-12 d-flex justify-content-end">
                <button type="button" id="resetFilters" class="btn btn-outline-secondary btn-sm">↺ Réinitialiser</button>
            </div>
        </div>
    </div>
</div>

{# ================================================================ #}
{# Version desktop : tableau                                        #}
{# ================================================================ #}
<div class="table-responsive d-none d-md-block">
    <table class="table table-bordered table-striped align-middle" id="usersTable">
        <thead>
            <tr>
                <th>Nom & Prénom</th>
                <th>Email</th>
                <th>Adhérent</th>
                <th>Abonnements & Cartes</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            {# ---- Données de filtre précalculées pour ce user ---- #}
            {% set abonnementIds = [] %}
            {% set carteIds = [] %}
            {% set disciplinesIds = [] %}
            {% set hasTarifReduit = false %}
            {% for ab in user.abonnementSouscrits %}
                {% if ab.statut != constant('App\\Enum\\Statut::CREATED') %}
                    {% set abonnementIds = abonnementIds|merge([ab.abonnement.id]) %}
                    {% set disciplinesIds = disciplinesIds|merge([ab.abonnement.discipline.id]) %}
                    {% if ab.isTarifReduit %}
                        {% set hasTarifReduit = true %}
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% for c in user.carteSouscrites %}
                {% if c.statut != constant('App\\Enum\\Statut::CREATED') %}
                    {% set carteIds = carteIds|merge([c.carte.id]) %}
                    {% for d in c.carte.disciplines %}
                        {% set disciplinesIds = disciplinesIds|merge([d.id]) %}
                    {% endfor %}
                    {% if c.isTarifReduit %}
                        {% set hasTarifReduit = true %}
                    {% endif %}
                {% endif %}
            {% endfor %}

            <tr data-nom="{{ user.nom }}" data-prenom="{{ user.prenom }}" data-email="{{ user.email }}"
                data-adhesion="{{ user.adhesion ? '1' : '0' }}"
                data-tarif-reduit="{{ hasTarifReduit ? '1' : '0' }}"
                data-abonnements="{{ abonnementIds|join(',') }}"
                data-cartes="{{ carteIds|join(',') }}"
                data-disciplines="{{ disciplinesIds|join(',') }}">

                <td>{{ user.nom }} {{ user.prenom }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {{ user.adhesion ? '✔️' : '❌' }}
                </td>
                <td>
                    {% set hasAbonnement = false %}
                    {% for ab in user.abonnementSouscrits %}
                        {% if ab.statut != constant('App\\Enum\\Statut::CREATED') %}
                            <div>
                                {{ ab.abonnement.nom }}
                                {% if ab.isTarifReduit and not ab.tarifReduitVerifie %}
                                    <form method="post"
                                          action="{{ path('admin_abonnement_verifier', {id: ab.id}) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('verifier_abonnement' ~ ab.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Vérifier le justificatif
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                            {% set hasAbonnement = true %}
                        {% endif %}
                    {% endfor %}
                    {% for c in user.carteSouscrites %}
                        {% if c.statut != constant('App\\Enum\\Statut::CREATED') %}
                            <div>
                                {{ c.carte.nom }} — Séances restantes: {{ c.seancesRestantes }}
                                <form method="post"
                                      action="{{ path('admin_carte_retirer_seance', {id: c.id}) }}">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('retirer_seance' ~ c.id) }}">
                                    <button type="submit" class="btn btn-warning">
                                        Retirer une séance
                                    </button>
                                </form>
                                {% if c.isTarifReduit and not c.tarifReduitVerifie %}
                                    <form method="post"
                                          action="{{ path('admin_carte_verifier', {id: c.id}) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('verifier_carte' ~ c.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success ms-1 mb-1">
                                            Vérifier
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                            {% set hasAbonnement = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not hasAbonnement %}
                        <span class="text-muted">Aucun en cours</span>
                    {% endif %}
                </td>
                <td>
                    <div class="d-flex flex-column gap-2">

                        <a href="{{ path('admin_user_inscription', {'id': user.id}) }}"
                           class="btn btn-sm btn-primary">
                            ➕ Ajouter une activité
                        </a>

                        <a href="{{ path('admin_user_edit', {'id': user.id}) }}"
                           class="btn btn-sm btn-outline-secondary">
                            ✏️ Modifier
                        </a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <form method="post"
                                  action="{{ path('admin_user_delete', {id: user.id}) }}"
                                  onsubmit="return confirm('Confirmer la suppression de cet utilisateur ?');">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                    🗑️ Supprimer
                                </button>
                            </form>
                        {% endif %}

                        {% if user.adhesion %}
                            <div class="border rounded p-2 mt-2 bg-light">
                                <div class="small fw-semibold text-muted mb-2">Carte de membre</div>

                                <div class="d-flex flex-wrap gap-2">
                                    <a href="{{ asset('cartesMembre/' ~ user.id ~ '.pdf') }}"
                                       class="btn btn-sm btn-outline-info"
                                       target="_blank"
                                       download="carte-adhesion-{{ user.nom }}-{{ user.prenom }}.pdf">
                                        📄 Télécharger
                                    </a>

                                    <form method="post"
                                          action="{{ path('admin_user_send_card', {id: user.id}) }}">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('send_card_' ~ user.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-info"
                                                onclick="return confirm('Envoyer la carte de membre à {{ user.email }} ?');">
                                            📧 Envoyer
                                        </button>
                                    </form>
                                </div>

                                <form method="post"
                                      action="{{ path('admin_user_regenerate_card', {id: user.id}) }}"
                                      class="mt-2">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('regenerate_card_' ~ user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-link text-warning px-0">
                                        🔄 Régénérer la carte
                                    </button>
                                </form>
                            </div>
                        {% endif %}

                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun utilisateur.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# ================================================================ #}
{# Version mobile : cartes                                          #}
{# ================================================================ #}
<div class="d-block d-md-none" id="usersCards">
    {% for user in users %}
        {# ---- Données de filtre précalculées pour ce user ---- #}
        {% set abonnementIds = [] %}
        {% set carteIds = [] %}
        {% set disciplinesIds = [] %}
        {% set hasTarifReduit = false %}
        {% for ab in user.abonnementSouscrits %}
            {% if ab.statut != constant('App\\Enum\\Statut::CREATED') %}
                {% set abonnementIds = abonnementIds|merge([ab.abonnement.id]) %}
                {% set disciplinesIds = disciplinesIds|merge([ab.abonnement.discipline.id]) %}
                {% if ab.isTarifReduit %}
                    {% set hasTarifReduit = true %}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% for c in user.carteSouscrites %}
            {% if c.statut != constant('App\\Enum\\Statut::CREATED') %}
                {% set carteIds = carteIds|merge([c.carte.id]) %}
                {% for d in c.carte.disciplines %}
                    {% set disciplinesIds = disciplinesIds|merge([d.id]) %}
                {% endfor %}
                {% if c.isTarifReduit %}
                    {% set hasTarifReduit = true %}
                {% endif %}
            {% endif %}
        {% endfor %}

        <div class="card mb-2 shadow-sm"
             data-nom="{{ user.nom }}" data-prenom="{{ user.prenom }}" data-email="{{ user.email }}"
             data-adhesion="{{ user.adhesion ? '1' : '0' }}"
             data-tarif-reduit="{{ hasTarifReduit ? '1' : '0' }}"
             data-abonnements="{{ abonnementIds|join(',') }}"
             data-cartes="{{ carteIds|join(',') }}"
             data-disciplines="{{ disciplinesIds|join(',') }}">
            <div class="card-body">
                <h5 class="card-title">{{ user.nom }} {{ user.prenom }}</h5>
                <p class="mb-1"><strong>Email:</strong> {{ user.email }}</p>
                <p class="mb-1"><strong>Adhérent:</strong> {{ user.adhesion ? '✔️' : '❌' }}</p>

                <p class="mb-1"><strong>Abonnements & Cartes:</strong>
                    {% set hasAbonnement = false %}
                    {% for ab in user.abonnementSouscrits %}
                        {% if ab.statut != constant('App\\Enum\\Statut::CREATED') %}
                            <div>
                                {{ ab.abonnement.nom }}
                                {% if ab.isTarifReduit and not ab.tarifReduitVerifie %}
                                    <form method="post"
                                          action="{{ path('admin_abonnement_verifier', {id: ab.id}) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('verifier_abonnement' ~ ab.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success ms-1">Vérifier</button>
                                    </form>
                                {% endif %}
                            </div>
                            {% set hasAbonnement = true %}
                        {% endif %}
                    {% endfor %}
                    {% for c in user.carteSouscrites %}
                        {% if c.statut != constant('App\\Enum\\Statut::CREATED') %}
                            <div>
                                {{ c.carte.nom }} — Séances restantes: {{ c.seancesRestantes }}
                                <form method="post"
                                      action="{{ path('admin_carte_retirer_seance', {id: c.id}) }}">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('retirer_seance' ~ c.id) }}">
                                    <button type="submit" class="btn btn-warning">Retirer une séance</button>
                                </form>
                                {% if c.isTarifReduit and not c.tarifReduitVerifie %}
                                    <form method="post"
                                          action="{{ path('admin_carte_verifier', {id: c.id}) }}"
                                          class="d-inline">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('verifier_carte' ~ c.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success ms-1 mb-1">Vérifier</button>
                                    </form>
                                {% endif %}
                            </div>
                            {% set hasAbonnement = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not hasAbonnement %}
                        <span class="text-muted">Aucun en cours</span>
                    {% endif %}
                </p>

                <div class="mt-2">
                    <div class="d-grid gap-2">
                        <a href="{{ path('admin_user_inscription', {'id': user.id}) }}"
                           class="btn btn-sm btn-primary">➕ Ajouter une activité</a>
                        <a href="{{ path('admin_user_edit', {'id': user.id}) }}"
                           class="btn btn-sm btn-outline-secondary">✏️ Modifier</a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <form method="post"
                                  action="{{ path('admin_user_delete', {id: user.id}) }}"
                                  onsubmit="return confirm('Confirmer la suppression de cet utilisateur ?');">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">🗑️ Supprimer</button>
                            </form>
                        {% endif %}
                    </div>

                    {% if user.adhesion %}
                        <div class="border rounded p-3 mt-3 bg-light">
                            <div class="fw-semibold mb-2">Carte de membre</div>
                            <div class="d-grid gap-2">
                                <a href="{{ asset('cartesMembre/' ~ user.id ~ '.pdf') }}"
                                   class="btn btn-sm btn-outline-info"
                                   target="_blank"
                                   download="carte-adhesion-{{ user.nom }}-{{ user.prenom }}.pdf">
                                    📄 Télécharger la carte
                                </a>
                                <form method="post"
                                      action="{{ path('admin_user_send_card', {id: user.id}) }}">
                                    <input type="hidden" name="_token"
                                           value="{{ csrf_token('send_card_' ~ user.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-info w-100"
                                            onclick="return confirm('Envoyer la carte de membre à {{ user.email }} ?');">
                                        📧 Envoyer par email
                                    </button>
                                </form>
                            </div>
                            <form method="post"
                                  action="{{ path('admin_user_regenerate_card', {id: user.id}) }}"
                                  class="mt-2">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('regenerate_card_' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-link text-warning px-0">
                                    🔄 Régénérer la carte
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <p>Aucun utilisateur.</p>
    {% endfor %}
</div>

{% endblock %}

{% block javascripts %}
<script>
function normalize(str) {
    return (str || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
}

// Algorithme simple Soundex JS
function soundex(s) {
    if (!s) return "";
    s = s.toUpperCase().replace(/[^A-Z]/g, "");
    const a = s.split("");
    const f = a.shift();
    const codes = {B:1,F:1,P:1,V:1,C:2,G:2,J:2,K:2,Q:2,S:2,X:2,Z:2,D:3,T:3,L:4,M:5,N:5,R:6};
    const result = [f];
    let prev = codes[f] || 0;
    for (let c of a) {
        const code = codes[c] || 0;
        if (code !== prev && code !== 0) result.push(code);
        prev = code;
    }
    return (result.join("") + "000").slice(0,4);
}

// Levenshtein distance
function levenshtein(a, b) {
    const al = a.length, bl = b.length;
    if (al === 0) return bl;
    if (bl === 0) return al;
    let matrix = [];
    for (let i=0;i<=bl;i++){matrix[i]=[i];}
    for (let j=0;j<=al;j++){matrix[0][j]=j;}
    for (let i=1;i<=bl;i++){
        for (let j=1;j<=al;j++){
            const cost = (b[i-1]===a[j-1])?0:1;
            matrix[i][j] = Math.min(
                matrix[i-1][j]+1,
                matrix[i][j-1]+1,
                matrix[i-1][j-1]+cost
            );
        }
    }
    return matrix[bl][al];
}

/**
 * Teste si un élément (ligne desktop OU carte mobile) passe tous les filtres actifs.
 */
function matchesFilters(el, term) {
    // ---- Recherche texte (fuzzy) ----
    if (term.length >= 3) {
        const nom = normalize(el.dataset.nom);
        const prenom = normalize(el.dataset.prenom);
        const email = normalize(el.dataset.email);
        const sdxTerm = soundex(term);

        const matchText = [nom, prenom, email].some(str =>
            str.includes(term)
            || levenshtein(term, str) <= 2
            || sdxTerm === soundex(str)
        );
        if (!matchText) return false;
    }

    // ---- Filtres multi-checkboxes (OU entre cases cochées, ET entre groupes) ----
    for (const group of document.querySelectorAll('.filter-group')) {
        const checked = [...group.querySelectorAll('input[type="checkbox"]:checked')].map(i => i.value);
        if (checked.length === 0) continue;  // aucun coché = pas de filtre

        const key = group.dataset.filter;   // discipline / abonnement / carte
        const attrName = { discipline: 'disciplines', abonnement: 'abonnements', carte: 'cartes' }[key];
        const list = (el.dataset[attrName] || '').split(',').filter(Boolean);

        if (!checked.some(v => list.includes(v))) return false;
    }

    // ---- Adhésion ----
    const adh = document.getElementById('filterAdhesion').value;
    if (adh !== '' && el.dataset.adhesion !== adh) return false;

    // ---- Tarif (réduit / plein) ----
    const tr = document.getElementById('filterTarif').value;
    if (tr !== '' && el.dataset.tarifReduit !== tr) return false;

    return true;
}

/**
 * Applique tous les filtres aux deux vues + met à jour le badge compteur.
 */
function applyFilters() {
    const term = normalize(document.getElementById('searchInput').value);

    let visible = 0;
    let total = 0;

    document.querySelectorAll('#usersTable tbody tr[data-nom], #usersCards .card[data-nom]')
        .forEach(el => {
            // ne compter qu'une fois par user : desktop OU mobile
            // (les deux vues existent dans le DOM, on compte la vue desktop)
            const isDesktopRow = el.closest('#usersTable') !== null;
            if (isDesktopRow) total++;
        });

    document.querySelectorAll('#usersTable tbody tr[data-nom], #usersCards .card[data-nom]')
        .forEach(el => {
            const show = matchesFilters(el, term);
            el.style.display = show ? '' : 'none';
            const isDesktopRow = el.closest('#usersTable') !== null;
            if (show && isDesktopRow) visible++;
        });

    // ---- Compteur de résultats ----
    const counter = document.getElementById('resultsCount');
    if (counter) {
        counter.innerHTML = '<strong>' + visible + '</strong> utilisateur' + (visible > 1 ? 's' : '')
            + ' affiché' + (visible > 1 ? 's' : '')
            + (visible < total ? ' sur ' + total : '');
    }

    // Badge : nombre de filtres actifs sur le bouton "Filtres"
    let count = document.querySelectorAll('.filter-group input[type="checkbox"]:checked').length;
    if (document.getElementById('filterAdhesion').value) count++;
    if (document.getElementById('filterTarif').value) count++;
    const badge = document.getElementById('filtersCount');
    if (badge) {
        badge.textContent = count;
        badge.classList.toggle('d-none', count === 0);
    }
}

// ---- Écouteurs en DÉLÉGATION sur document : robustes quel que soit
//      l'ordre de chargement du script par rapport au HTML ----
document.addEventListener('input', e => {
    if (e.target && e.target.id === 'searchInput') applyFilters();
});

document.addEventListener('change', e => {
    if (!e.target) return;
    if (e.target.closest && e.target.closest('.filter-group')) applyFilters();
    if (e.target.id === 'filterAdhesion' || e.target.id === 'filterTarif') applyFilters();
});

document.addEventListener('click', e => {
    if (e.target && e.target.id === 'resetFilters') {
        document.querySelectorAll('.filter-group input[type="checkbox"]').forEach(cb => cb.checked = false);
        document.getElementById('filterAdhesion').value = '';
        document.getElementById('filterTarif').value = '';
        applyFilters();
    }
});

// État initial (recherche éventuellement pré-remplie depuis l'URL)
document.addEventListener('DOMContentLoaded', applyFilters);
applyFilters();
</script>
{% endblock %}