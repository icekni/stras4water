{% extends 'base/base_admin.html.twig' %}

{% block title %}Vérification de {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block body %}
    <h1>Vérification de l'utilisateur</h1>
    <p><strong>Nom :</strong> {{ user.nom }} {{ user.prenom }}</p>
    <p><strong>Email :</strong> {{ user.email }}</p>
    <p>
        <strong>Adhésion :</strong>
        {% if user.isAdherent %}
            ✅ En cours
        {% else %}
            ❌ Non actif
        {% endif %}
    </p>

<h2>Abonnements en cours</h2>
<ul class="list-group">
{% for ab in abonnements %}
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
            <strong>{{ ab.abonnement.discipline.nom }}</strong> — Saison : {{ ab.abonnement.saison.nom }}
            {% if ab.isTarifReduit and not ab.tarifReduitVerifie %}
                <span class="ms-2">
                    ⚠️ Justificatif non vérifié
                    <a href="{{ path('admin_abonnement_verifier', {id: ab.id}) }}" 
                        class="btn btn-sm btn-success ms-1">Vérifier</a>
                </span>
            {% endif %}
        </div>
    </li>
{% else %}
    <li class="list-group-item">Aucun abonnement souscrit.</li>
{% endfor %}
</ul>

<h2>Cartes souscrites</h2>
<ul class="list-group">
{% for c in cartes %}
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <div>
            <strong>
                {% for discipline in c.carte.disciplines %}
                    {{ discipline.nom }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            </strong> — Séances restantes : {{ c.seancesRestantes }}
            {% if c.isTarifReduit and not c.tarifReduitVerifie %}
                <span class="ms-2">
                    ⚠️ Justificatif non vérifié
                    <a href="{{ path('admin_carte_verifier', {id: c.id}) }}" 
                        class="btn btn-sm btn-success ms-1">Vérifier</a>
                </span>
            {% endif %}
            <span class="ms-2">
                <a href="{{ path('admin_carte_retirer_seance', {id: c.id}) }}"
                   class="btn btn-sm btn-danger ms-1"
                   onclick="return confirm('Retirer une séance de cette carte ?');">
                   Retirer une séance
                </a>
            </span>
        </div>
    </li>
{% else %}
    <li class="list-group-item">Aucune carte souscrite.</li>
{% endfor %}
</ul>
<div class="mt-4">
    <a href="{{ path('admin_user_scan') }}" class="btn btn-secondary">
        ← Retour à la page de scan
    </a>
</div>
{% endblock %}
