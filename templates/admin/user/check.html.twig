{% extends 'base/base_admin.html.twig' %}

{% block title %}Vérification de {{ user.prenom }} {{ user.nom }}{% endblock %}

{% block body %}
    <h1>Vérification de l'utilisateur</h1>
    <p><strong>Nom :</strong> {{ user.nom }} {{ user.prenom }}</p>
    <p><strong>Email :</strong> {{ user.email }}</p>
    <p>
        <strong>Adhésion :</strong>
        {% if user.isAdherent %}
            ✅ En cours
        {% else %}
            ❌ Non actif
        {% endif %}
    </p>

    <h2>Abonnements en cours</h2>
    {% for ab in abonnements %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <p><strong>{{ ab.abonnement.discipline.nom }}</strong>
                — Saison : {{ ab.abonnement.saison.nom }}</p>            
            {% if ab.isTarifReduit and not ab.tarifReduitVerifie %}
                <p>⚠️ Justificatif non vérifié
                <a href="{{ path('admin_abonnement_verifier', {id: ab.id}) }}" 
                    class="btn btn-sm btn-success">
                    Vérifier
                </a></p>
            {% endif %}
                <br>
            </div>
        </li>
    {% else %}
            Aucun abonnement souscrit.
    {% endfor %}

    <h2>Cartes souscrites</h2>
    {% for c in cartes %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <p><strong>
                    {% for discipline in c.carte.disciplines %}
                        {{ discipline.nom }} 
                    {% endfor %}
                </strong>
                — Nombre de séances restantes : {{ c.seancesRestantes }}</p>            
                {% if c.isTarifReduit and not c.tarifReduitVerifie %}
                    <p>⚠️ Justificatif non vérifié
                    <a href="{{ path('admin_carte_verifier', {id: c.id}) }}" 
                        class="btn btn-sm btn-success">
                        Vérifier
                    </a></p>
                {% endif %}
                    <a href="{{ path('admin_carte_retirer_seance', {id: c.id}) }}"
                        class="btn btn-sm btn-danger"
                        onclick="return confirm('Retirer une séance de cette carte ?');">
                        Retirer une séance
                    </a>
                <br>
            </div>
        </li>
    {% else %}
            Aucune carte souscrite.
    {% endfor %}
{% endblock %}
