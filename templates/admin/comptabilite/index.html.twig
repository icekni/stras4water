{% extends 'base/base_admin.html.twig' %}

{% block title %}Comptabilité{% endblock %}

{% block body %}

<h1>Comptabilité</h1>

<div class="d-flex justify-content-between align-items-end mb-4">

    <div>

        <form method="get" class="row g-3 align-items-end m-0">

            <div class="col-auto">
                <label for="from" class="form-label">Du</label>
                <input
                    type="date"
                    id="from"
                    name="from"
                    value="{{ from }}"
                    class="form-control">
            </div>

            <div class="col-auto">
                <label for="to" class="form-label">Au</label>
                <input
                    type="date"
                    id="to"
                    name="to"
                    value="{{ to }}"
                    class="form-control">
            </div>

            <div class="col-auto">
                <button class="btn btn-primary">
                    Filtrer
                </button>
            </div>

        </form>

        <p class="mt-2 mb-0">
            Période rapide :
            <a href="#" class="periode" data-months="3">3 mois</a> |
            <a href="#" class="periode" data-months="6">6 mois</a> |
            <a href="#" class="periode" data-months="12">1 an</a>
        </p>

    </div>

    <div class="d-flex gap-2">

        <a
            class="btn btn-success"
            href="{{ path('admin_comptabilite_export', {
                from: from,
                to: to
            }) }}">
            Export CSV
        </a>

        <button
            type="button"
            class="btn btn-warning"
            data-bs-toggle="modal"
            data-bs-target="#exportMailModal">
            Envoyer par mail
        </button>

    </div>

</div>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Libellé</th>
            <th>Tarif (Réduit/plein)</th>
            <th>Discipline</th>
            <th>Paiement</th>
        </tr>
    </thead>

    <tbody>

    {% for ligne in lignes %}

        <tr>
            <td>{{ ligne.date|date('d/m/Y H:i') }}</td>
            <td>{{ ligne.type }}</td>
            <td>{{ ligne.libelle }}</td>
            <td>{{ ligne.typeTarif }}</td>
            <td>{{ ligne.discipline }}</td>
            <td>{{ ligne.moyenPaiement.name }}</td>
        </tr>

    {% else %}

        <tr>
            <td colspan="6">
                Aucun résultat.
            </td>
        </tr>

    {% endfor %}

    </tbody>

</table>

<div
    class="modal fade"
    id="exportMailModal"
    tabindex="-1"
    aria-labelledby="exportMailModalLabel"
    aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form
                method="post"
                action="{{ path('admin_comptabilite_export_mail') }}">

                <div class="modal-header">
                    <h5 class="modal-title" id="exportMailModalLabel">
                        Envoyer le CSV par e-mail
                    </h5>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer">
                    </button>
                </div>

                <div class="modal-body">

                    <p>
                        Saisissez l'adresse e-mail à laquelle envoyer le fichier CSV.
                    </p>

                    <input type="hidden" name="from" value="{{ from }}">
                    <input type="hidden" name="to" value="{{ to }}">
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('export_csv_mail') }}">

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Adresse e-mail
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            placeholder="exemple@domaine.fr"
                            required>
                    </div>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                        Annuler
                    </button>

                    <button
                        type="submit"
                        class="btn btn-warning">
                        Envoyer
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<script>

const from = document.getElementById('from');
const to = document.getElementById('to');

document.querySelectorAll('.periode').forEach(link => {

    link.addEventListener('click', e => {

        e.preventDefault();

        const months = parseInt(link.dataset.months);

        const end = new Date();
        const start = new Date();

        start.setMonth(start.getMonth() - months);

        from.value = start.toISOString().slice(0, 10);
        to.value = end.toISOString().slice(0, 10);

    });

});

</script>

{% endblock %}