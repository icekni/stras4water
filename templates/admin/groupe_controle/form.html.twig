{% extends 'base/base_admin.html.twig' %}

{% block title %}
    {{ groupe.id ? 'Modifier un groupe de contrôle' : 'Nouveau groupe de contrôle' }}
{% endblock %}

{% block body %}

<div class="container">

    <h1 class="mb-4">
        {{ groupe.id ? 'Modifier le groupe de contrôle' : 'Nouveau groupe de contrôle' }}
    </h1>

    {{ form_start(form) }}

    {{ form_row(form.nom) }}
    {{ form_row(form.isActif) }}

    <hr>

    <h2 class="h4 mb-3">Abonnements</h2>

    {{ form_widget(form.abonnementsActifs) }}

    {% if form.abonnementsPrecedents|length > 0 %}
        <details class="mt-3 mb-4">
            <summary>
                Saisons précédentes
            </summary>

            <div class="mt-3">
                {{ form_widget(form.abonnementsPrecedents) }}
            </div>
        </details>
    {% endif %}

    <hr>

    <h2 class="h4 mb-3">Cartes</h2>

    {{ form_widget(form.cartes) }}

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            Enregistrer
        </button>

        <a href="{{ path('admin_groupe_controle_index') }}"
           class="btn btn-secondary">
            Annuler
        </a>
    </div>

    {{ form_end(form) }}

</div>

{% endblock %}