{% extends 'base/base_admin.html.twig' %}

{% block title %}{{ event.nom }}{% endblock %}

{% block body %}

<div class="d-flex align-items-center mb-3">

    <h1 class="mb-0">{{ event.nom }}</h1>

    <div class="d-flex gap-2 ms-3">
        <a
            href="{{ path('admin_event_edit', {id: event.id}) }}"
            class="btn btn-primary"
        >
            <i class="bi bi-pencil"></i>
            Modifier
        </a>

        {% if is_granted('ROLE_ADMIN') %}
            <form
                method="post"
                action="{{ path('admin_event_delete', {id: event.id}) }}"
                class="d-inline"
                onsubmit="return confirm('Voulez-vous vraiment supprimer cet événement ? Cette action est irréversible.');"
            >
                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('delete_event_' ~ event.id) }}"
                >

                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash"></i>
                    Supprimer
                </button>
            </form>
        {% endif %}
    </div>

    <a
        href="{{ path('admin_event_index') }}"
        class="btn btn-secondary ms-auto"
    >
        ← Retour
    </a>

</div>


{# Informations générales #}

<div class="card">
    <div class="card-body">

        <p>
            <strong>Type :</strong>
            {{ event.type.name }}
        </p>

        {% if event.description %}
            <p>
                <strong>Description :</strong><br>
                {{ event.description|nl2br }}
            </p>
        {% endif %}

        <p>
            <strong>Début :</strong>
            {{ event.startAt|date('d/m/Y à H:i') }}
        </p>

        {% if event.endAt %}
            <p>
                <strong>Fin :</strong>
                {{ event.endAt|date('d/m/Y à H:i') }}
            </p>
        {% endif %}

        {% if event.location %}
            <p>
                <strong>Lieu :</strong>
                {{ event.location }}
            </p>
        {% endif %}

        {% if event.adress %}
            <p>
                <strong>Adresse :</strong>
                {{ event.adress }}
            </p>
        {% endif %}

        {% if event.image %}
            <p class="mb-2">
                <strong>Image :</strong>
            </p>

            <img
                src="{{ asset(event.image) }}"
                alt="{{ event.nom }}"
                class="img-fluid rounded"
                style="max-height: 400px;"
            >
        {% endif %}

    </div>
</div>


{# Workshops #}

{% if event.workshops|length > 0 %}

    <h2 class="mt-4">Workshops</h2>

    <div class="table-responsive">
        <table class="table table-bordered align-middle">

            <thead>
                <tr>
                    <th>Workshop</th>
                    <th>Description</th>
                    <th>Début</th>
                    <th>Fin</th>
                </tr>
            </thead>

            <tbody>

            {% for workshop in event.workshops %}

                <tr>

                    <td>
                        <strong>{{ workshop.nom }}</strong>
                    </td>

                    <td>
                        {% if workshop.description %}
                            {{ workshop.description|nl2br }}
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>

                    <td>
                        {{ workshop.startAt|date('d/m/Y H:i') }}
                    </td>

                    <td>
                        {% if workshop.endAt %}
                            {{ workshop.endAt|date('d/m/Y H:i') }}
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>

                </tr>

            {% endfor %}

            </tbody>
        </table>
    </div>

{% endif %}


{# Liens #}

{% if event.links|length > 0 %}

    <h2 class="mt-4">Liens</h2>

    <div class="list-group">

        {% for link in event.links %}

            <a
                href="{{ link.url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
            >
                <span>
                    <i class="bi bi-link-45deg"></i>
                    {{ link.nom }}
                </span>

                <i class="bi bi-box-arrow-up-right"></i>
            </a>

        {% endfor %}

    </div>

{% endif %}

{% endblock %}