{% extends 'base/base_admin.html.twig' %}

{% block title %}
    {{ discipline.id is defined ? 'Modifier une discipline' : 'Ajouter une discipline' }}
{% endblock %}

{% block body %}
    <h1>{{ discipline.id is defined ? 'Modifier la discipline' : 'Ajouter une discipline' }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        <button class="btn btn-success mt-3">Enregistrer</button>
    {{ form_end(form) }}

    <a href="{{ path('admin_discipline_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
{% endblock %}
