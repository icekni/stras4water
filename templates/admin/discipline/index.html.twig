{% extends 'base/base_admin.html.twig' %}

{% block title %}Disciplines{% endblock %}

{% block body %}
    <h1>Disciplines</h1>
    <a href="{{ path('admin_discipline_new') }}" class="btn btn-primary mb-3">Ajouter une discipline</a>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for discipline in disciplines %}
            <tr>
                <td>{{ discipline.nom }}</td>
                <td>
                    {% if discipline.isActif %}
                        <span class="badge bg-success">Oui</span>
                    {% else %}
                        <span class="badge bg-secondary">Non</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('admin_discipline_edit', {id: discipline.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    <form method="post" action="{{ path('admin_discipline_delete', {id: discipline.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette discipline ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_discipline_' ~ discipline.id) }}">
                        <button class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3">Aucune discipline enregistrée.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
