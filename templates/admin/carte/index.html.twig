{% extends 'base/base_admin.html.twig' %}

{% block title %}Cartes de 10 cours{% endblock %}

{% block body %}
    <h1 class="mb-4">Cartes de cours</h1>

    <a href="{{ path('admin_carte_new') }}" class="btn btn-success mb-3">+ Nouvelle carte</a>

    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Nom</th>
                <th>Nombre de séances</th>
                <th>Tarif</th>
                <th>Tarif réduit</th>
                <th>Disciplines</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for carte in cartes %}
            <tr>
                <td>{{ carte.nom }}</td>
                <td>{{ carte.nombreSeances }}</td>
                <td>{{ carte.tarif|number_format(2, '.', ' ') }} €</td>
                <td>
                    {% if carte.hasTarifReduit %}
                        {{ carte.tarifReduit|number_format(2, '.', ' ') }} €
                    {% else %}
                        —
                    {% endif %}
                </td>
                <td>
                    {% for d in carte.disciplines %}
                        <span class="badge bg-primary">{{ d.nom }}</span>
                    {% else %}
                        <em>Aucune</em>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('admin_carte_edit', {id: carte.id}) }}" class="btn btn-sm btn-primary">✏️ Modifier</a>

                    <form method="post" action="{{ path('admin_carte_delete', {id: carte.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette carte ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carte.id) }}">
                        <button class="btn btn-sm btn-danger">🗑 Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7"><em>Aucune carte trouvée.</em></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
