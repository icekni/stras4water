{% extends 'base/base_admin.html.twig' %}

{% block title %}{{ carte.id ? 'Modifier une carte' : 'Nouvelle carte' }}{% endblock %}

{% block body %}
    <h1>{{ carte.id ? 'Modifier une carte' : 'Nouvelle carte' }}</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-primary mt-3">{{ carte.id ? 'Mettre à jour' : 'Créer' }}</button>
    {{ form_end(form) }}

    <a href="{{ path('admin_carte_index') }}" class="btn btn-link mt-3">← Retour à la liste</a>
{% endblock %}
