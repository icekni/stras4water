{% extends 'base/base_admin.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container-fluid pt-4 px-2">

    <!-- Statistiques -->
    <div class="row g-3 mb-4">
        <!-- Dons -->
        <div class="col-12 col-md-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center p-3">
                <i class="bi bi-cash-coin fs-2 text-warning me-2"></i>
                <div>
                    <p class="mb-1 small">Dons</p>
                    <h6 class="mb-0">{{ montantTotal }} €</h6>
                    <small class="text-muted">ces {{ donationInterval }} derniers jours</small>
                </div>
            </div>
        </div>

        {% if usersPerDiscipline is defined %}
            {% for discipline, count in usersPerDiscipline %}
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="bg-light rounded d-flex align-items-center p-3">
                        <i class="bi bi-person-lines-fill fs-2 text-primary me-2"></i>
                        <div>
                            <p class="mb-1 small">{{ discipline }}</p>
                            <h6 class="mb-0">{{ count }} participant(s)</h6>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <!-- Liste des utilisateurs -->
    <div class="bg-white rounded shadow-sm p-3">
        <h5 class="mb-3">Liste des utilisateurs</h5>

        <!-- Desktop -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.nom }}</td>
                            <td>{{ user.prenom }}</td>
                            <td>{{ user.email }}</td>
                            <td class="text-center">
                                <a href="{{ path('admin_user_check', {id: user.id}) }}" class="btn btn-sm btn-outline-primary">Consulter</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucun utilisateur.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Mobile -->
        <div class="d-block d-md-none">
            {% for user in users %}
                <div class="card mb-2 shadow-sm">
                    <div class="card-body d-flex align-items-center p-2">
                        <i class="bi bi-person-fill fs-3 text-primary me-2"></i>
                        <div class="flex-grow-1">
                            <div class="fw-bold">{{ user.nom }} {{ user.prenom }}</div>
                            <div class="small text-muted">{{ user.email }}</div>
                        </div>
                        <a href="{{ path('admin_user_check', {id: user.id}) }}" class="btn btn-sm btn-outline-primary">Consulter</a>
                    </div>
                </div>
            {% else %}
                <p>Aucun utilisateur.</p>
            {% endfor %}
        </div>

    </div>
</div>
{% endblock %}
