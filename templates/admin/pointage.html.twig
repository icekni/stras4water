{% extends 'base.html.twig' %}

{% block title %}Recherche d'utilisateurs{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Recherche d’utilisateurs ou de personnes passées</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <input
                type="text"
                id="search-input"
                class="form-control"
                placeholder="Tapez un nom, prénom ou email..."
                autocomplete="off"
            >
        </div>

        <div class="col-md-6">
            <select id="discipline-select" class="form-select">
                <option value="">Sélectionnez la discipline</option>
                {% for discipline in disciplines %}
                    <option value="{{ discipline.id }}">{{ discipline.nom }}</option>
                {% endfor %}
            </select>
        </div>
    </div>

    <div id="search-results">
        <!-- Résultats dynamiques ici -->
    </div>
</div>

<script>
    const input = document.getElementById('search-input');
    const discipline = document.getElementById('discipline-select');
    const results = document.getElementById('search-results');
    let timeout = null;

    function triggerSearch() {
        const query = input.value.trim();
        const disciplineId = discipline.value;

        if (query.length < 2 || !disciplineId) {
            results.innerHTML = '<p class="text-muted">Tapez un nom et sélectionnez une discipline.</p>';
            return;
        }

        fetch(`{{ path('admin_user_search') }}?q=${encodeURIComponent(query)}&discipline=${disciplineId}`)
            .then(response => response.json())
            .then(data => {
                if (data.length === 0) {
                    results.innerHTML = '<p>Aucun résultat.</p>';
                    return;
                }

                results.innerHTML = '<ul class="list-group">';
                data.forEach(user => {
                    results.innerHTML += `
                        <li class="list-group-item">
                            <strong>${user.nom}</strong> ${user.prenom || ''} 
                            ${user.email ? '- <em>' + user.email + '</em>' : ''}
                            ${user.type ? '<span class="badge bg-secondary ms-2">' + user.type + '</span>' : ''}
                        </li>
                    `;
                });
                results.innerHTML += '</ul>';
            });
    }

    input.addEventListener('input', () => {
        clearTimeout(timeout);
        timeout = setTimeout(triggerSearch, 300);
    });

    discipline.addEventListener('change', triggerSearch);
</script>
{% endblock %}
