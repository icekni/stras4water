{% extends 'base_admin.html.twig' %}

{% block title %}Liens{% endblock %}

{% block body %}
    <h1>Liens</h1>
    <a href="{{ path('admin_lien_new') }}" class="btn btn-primary mb-3">Créer un nouveau lien</a>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>QR Code</th>
                <th>Clics</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lien in liens %}
            <tr>
                <td>{{ lien.description }}</td>
                <td>
                    <button class="btn btn-sm btn-secondary" data-bs-toggle="modal" data-bs-target="#qrModal{{ lien.id }}">
                        Voir le QR Code
                    </button>
                </td>
                <td>{{ lien.clics|length }}</td>
                <td>
                    <a href="{{ path('admin_lien_show', {id: lien.id}) }}" class="btn btn-sm btn-info">Stats</a>
                    <a href="{{ path('admin_lien_edit', {id: lien.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                    <form method="post" action="{{ path('admin_lien_delete', {id: lien.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer ce lien ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_lien_' ~ lien.id) }}">
                        <button class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun lien pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>

    {% for lien in liens %}
        <div class="modal fade" id="qrModal{{ lien.id }}" tabindex="-1" aria-labelledby="qrModalLabel{{ lien.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="qrModalLabel{{ lien.id }}">QR Code du lien</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img src="{{ asset(lien.qrCodePath|replace({'public/': ''})) }}" alt="QR Code" class="img-fluid mb-3">
                        <br>
                        <a href="{{ asset(lien.qrCodePath|replace({'public/': ''})) }}"  download="{{ lien.description|slug }}.png" class="btn btn-primary">
                            Télécharger le QR Code
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

{% endblock %}
