{% extends 'base/base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-lg rounded-4">
        <div class="card-body p-4">

        <h2 class="mb-4 text-center">Mot de passe oublié</h2>

        <p class="text-muted">
            Indiquez l’adresse e-mail associée à votre compte.
            Si un compte correspond à cette adresse, vous recevrez un
            lien pour réinitialiser votre mot de passe.
        </p>

        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.email, null, {
                'label_attr': {'class': 'form-label'}
            }) }}

            {{ form_widget(form.email, {
                'attr': {
                    'class': 'form-control'
                }
            }) }}

            {{ form_errors(form.email) }}
        </div>

        <div class="d-grid">
            {{ form_widget(form.submit, {
                'attr': {
                    'class': 'btn btn-primary btn-lg rounded-pill'
                }
            }) }}
        </div>

        {{ form_end(form) }}

        <p class="mt-3 text-center">
            <a href="{{ path('app_login') }}">Retour à la connexion</a>
        </p>

    </div>
</div>

</div>
{% endblock %}
