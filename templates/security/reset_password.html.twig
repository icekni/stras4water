{% extends 'base/base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-lg rounded-4">
        <div class="card-body p-4">

            <h2 class="mb-4 text-center">Nouveau mot de passe</h2>

            <p class="text-muted">
                Choisissez votre nouveau mot de passe.
            </p>

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.password.first, null, {
                    'label_attr': {'class': 'form-label'}
                }) }}

                {{ form_widget(form.password.first, {
                    'attr': {
                        'class': 'form-control'
                    }
                }) }}

                {{ form_errors(form.password.first) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.password.second, null, {
                    'label_attr': {'class': 'form-label'}
                }) }}

                {{ form_widget(form.password.second, {
                    'attr': {
                        'class': 'form-control'
                    }
                }) }}

                {{ form_errors(form.password.second) }}
            </div>

            {{ form_errors(form.password) }}

            <div class="d-grid">
                {{ form_widget(form.submit, {
                    'attr': {
                        'class': 'btn btn-primary btn-lg rounded-pill'
                    }
                }) }}
            </div>

            {{ form_end(form) }}

            <p class="mt-3 text-center">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </p>

        </div>
    </div>
</div>
{% endblock %}
