<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
        }
        .sidebar-lg {
            width: 220px;
            min-height: 100vh;
            background-color: #ffffff;
            border-right: 1px solid #dee2e6;
        }
        .content-area {
            padding: 20px;
            flex: 1;
        }
        .navbar-container {
            max-width: 1024px;
            margin: 0 auto;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Top bar -->
    <nav class="navbar navbar-light bg-white border-bottom shadow-sm">
        <div class="container navbar-container d-flex align-items-center justify-content-between">
            <!-- Menu toggle bouton mobile -->
            <button class="btn btn-outline-primary d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar" aria-controls="offcanvasSidebar">
                <i class="bi bi-list"></i>
            </button>

            <!-- Logo -->
            <div class="d-flex align-items-center">
                <img src="{{ asset('img/logo.png') }}" alt="Logo" style="height: 60px; margin-right: 10px;">
            </div>

            <!-- Titre -->
            <div class="text-center flex-grow-1" style="font-size: 20px; font-weight: bold; color: #2d87f0;">
                Dashboard Admin
            </div>

            <!-- Heure + Dropdown -->
            <div class="d-flex align-items-center">
                <div class="me-3 text-muted small text-end" id="datetime"></div>
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-2"></i>
                        {{ app.user.email }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page content -->
    <div class="d-flex">
        <!-- Sidebar large écran -->
        <div class="d-none d-lg-block sidebar-lg p-3">
            <h6 class="text-uppercase text-muted">Navigation</h6>
                <ul class="nav flex-column">
                    <!-- Accueil -->
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link">Accueil</a>
                    </li>

                    <!-- Scanner une carte -->
                    <li class="nav-item">
                        <a href="{{ path('admin_user_scan') }}" class="nav-link">Scanner une carte</a>
                    </li>

                    <!-- Liste des utilisateurs -->
                    <li class="nav-item">
                        <a href="{{ path('admin_user_index') }}" class="nav-link">Utilisateurs</a>
                    </li>

                    <!-- Dons -->
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#submenu-dons" role="button" aria-expanded="false" aria-controls="submenu-dons">
                            Dons
                        </a>
                        <div class="collapse ps-3" id="submenu-dons">
                            <a href="{{ path('admin_donations_create') }}" class="nav-link">Créer un don</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_donations_index') }}" class="nav-link">Tous les dons</a>
                            {% endif %}
                        </div>
                    </li>

                    {% if is_granted('ROLE_ADMIN') %}

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#submenu-souscription" role="button" aria-expanded="false" aria-controls="submenu-souscription">
                                Souscriptions
                            </a>
                            <div class="collapse ps-3" id="submenu-souscription">
                                <a href="{{ path('admin_abonnement_index') }}" class="nav-link">Abonnements</a>
                                <a href="{{ path('admin_carte_index') }}" class="nav-link">Cartes</a>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#submenu-configuration" role="button" aria-expanded="false" aria-controls="submenu-configuration">
                                Configuration
                            </a>
                            <div class="collapse ps-3" id="submenu-configuration">
                                <a href="{{ path('admin_discipline_index') }}" class="nav-link">Disciplines</a>
                                <a href="{{ path('admin_saison_index') }}" class="nav-link">Saisons</a>
                                <a href="{{ path('admin_abonnement_index') }}" class="nav-link">Abonnements</a>
                                <a href="{{ path('admin_carte_index') }}" class="nav-link">Cartes</a>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#submenu-liens" role="button" aria-expanded="false" aria-controls="submenu-liens">
                                Gestion des liens
                            </a>
                            <div class="collapse ps-3" id="submenu-liens">
                                <a href="{{ path('admin_links_index') }}" class="nav-link">Tous les liens</a>
                                <a href="{{ path('admin_links_new') }}" class="nav-link">Créer un lien</a>
                            </div>
                        </li>

                        <!-- Comptabilité -->
                        <li class="nav-item">
                            <a href="{{ path('admin_comptabilite_index') }}" class="nav-link">Comptabilité</a>
                        </li>
                    {% endif %}
                </ul>
        </div>

        <!-- Offcanvas mobile -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasSidebar" aria-labelledby="offcanvasSidebarLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasSidebarLabel">Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h6 class="text-uppercase text-muted">Navigation</h6>
                    <ul class="nav flex-column">
                        <!-- Accueil -->
                        <li class="nav-item">
                            <a href="{{ path('admin_dashboard') }}" class="nav-link">Accueil</a>
                        </li>

                        <!-- Scanner une carte -->
                        <li class="nav-item">
                            <a href="{{ path('admin_user_scan') }}" class="nav-link">Scanner une carte</a>
                        </li>

                        <!-- Liste des utilisateurs -->
                        <li class="nav-item">
                            <a href="{{ path('admin_user_index') }}" class="nav-link">Utilisateurs</a>
                        </li>

                        <!-- Dons -->
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="collapse" href="#submenu-dons-mobile" role="button" aria-expanded="false" aria-controls="submenu-dons-mobile">
                                Dons
                            </a>
                            <div class="collapse ps-3" id="submenu-dons-mobile">
                                <a href="{{ path('admin_donations_create') }}" class="nav-link">Créer un don</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('admin_donations_index') }}" class="nav-link">Tous les dons</a>
                                {% endif %}
                            </div>
                        </li>

                        {% if is_granted('ROLE_ADMIN') %}

                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="collapse" href="#submenu-souscription-mobile" role="button" aria-expanded="false" aria-controls="submenu-souscription-mobile">
                                    Souscriptions
                                </a>
                                <div class="collapse ps-3" id="submenu-souscription-mobile">
                                    <a href="{{ path('admin_abonnement_index') }}" class="nav-link">Abonnements</a>
                                    <a href="{{ path('admin_carte_index') }}" class="nav-link">Cartes</a>
                                </div>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="collapse" href="#submenu-configuration-mobile" role="button" aria-expanded="false" aria-controls="submenu-configuration-mobile">
                                    Configuration
                                </a>
                                <div class="collapse ps-3" id="submenu-configuration-mobile">
                                    <a href="{{ path('admin_discipline_index') }}" class="nav-link">Disciplines</a>
                                    <a href="{{ path('admin_saison_index') }}" class="nav-link">Saisons</a>
                                    <a href="{{ path('admin_abonnement_index') }}" class="nav-link">Abonnements</a>
                                    <a href="{{ path('admin_carte_index') }}" class="nav-link">Cartes</a>
                                </div>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="collapse" href="#submenu-liens-mobile" role="button" aria-expanded="false" aria-controls="submenu-liens-mobile">
                                    Gestion des liens
                                </a>
                                <div class="collapse ps-3" id="submenu-liens-mobile">
                                    <a href="{{ path('admin_links_index') }}" class="nav-link">Tous les liens</a>
                                    <a href="{{ path('admin_links_new') }}" class="nav-link">Créer un lien</a>
                                </div>
                            </li>

                            <!-- Comptabilité -->
                            <li class="nav-item">
                                <a href="{{ path('admin_comptabilite_index') }}" class="nav-link">Comptabilité</a>
                            </li>
                        {% endif %}
                    </ul>
            </div>
        </div>

        <!-- Main Content -->
        <div class="content-area">
            <div class="container-fluid">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
            {% block body %}{% endblock %}
        </div>
    </div>

    <!-- JS Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Heure JS -->
    <script>
        function updateDateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const dateString = now.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            document.getElementById('datetime').textContent = dateString + ' - ' + timeString;
        }
        setInterval(updateDateTime, 1000);
        updateDateTime();
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
