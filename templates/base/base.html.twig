<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Stras4Water | Salsa, bachata et activités à Strasbourg{% endblock %}</title>
		<meta name="description" content="{% block meta_description %}Stras4Water est une association à Strasbourg qui organise des activités de danse, des événements et des actions solidaires au profit de l'accès à l'eau potable.{% endblock %}">
		<meta name="robots" content="{% block robots %}index, follow{% endblock %}">
		<link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">
		<meta property="og:type" content="{% block og_type %}website{% endblock %}">
		<meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
		<meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
		<meta property="og:url" content="{% block og_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">
		<meta property="og:site_name" content="Stras4Water">
		<meta property="og:locale" content="fr_FR">
		{% block og_image %}
		<meta property="og:image" content="{{ absolute_url(asset('img/logo.png')) }}">
		{% endblock %}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous"> {% block stylesheets %}{% endblock %}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
		<link rel="icon" type="image/png" href="{{ asset('img/favicon-96x96.png') }}" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="{{ asset('img/favicon.svg') }}" />
		<link rel="shortcut icon" href="{{ asset('img/favicon.ico') }}" />
		<link rel="apple-touch-icon" sizes="180x180" href="{{ asset('img/apple-touch-icon.png') }}" />
		<link rel="manifest" href="{{ asset('img/site.webmanifest') }}" />
		<style>
			/* ============ Charte 4water.org ============
			   charbon = structure | bleu = identité | rouge = action
			============================================= */
			:root {
				--s4w-charbon: #2b2b2b;
				--s4w-charbon-mid: #3d3d3d;
				--s4w-bleu: #0096c7;
				--s4w-bleu-vif: #00b4d8;
				--s4w-bleu-bg: #e8f6fb;
				--s4w-rouge: #e63946;
				--s4w-rouge-dark: #c1121f;
				--s4w-encre: #2b2b2b;
				--s4w-gris: #666f73;
			}

			body {
				background-color: #ffffff; /* corps blanc comme 4water */
				color: var(--s4w-encre);
				font-family: 'Segoe UI', system-ui, sans-serif;
				padding-top: 118px; /* topbar (~32px) + navbar (~86px) — ajuste selon la hauteur réelle du logo */
			}

			h1, h2, h3, h4 { color: var(--s4w-charbon); }

			/* ---------- Topbar : compteur réseau 4Water ---------- */
			.topbar {
				background: var(--s4w-charbon);
				color: #b9ccd6;
				font-size: .8rem;
				padding: 6px 16px;
			}
			.topbar strong { color: var(--s4w-bleu-vif); }

			/* ---------- Navbar charbon ---------- */
			.navbar {
				background: var(--s4w-charbon);
				box-shadow: 0 2px 8px rgba(0,0,0,.25);
			}
			/* Anti-débordement desktop : une seule ligne, jamais de retour à la ligne */
			.navbar .container-fluid { flex-wrap: nowrap; }
			.navbar-brand { flex: 0 0 auto; padding-top: .25rem; padding-bottom: .25rem; }
			.navbar-brand img { height: 48px; width: auto; }
			.navbar .navbar-collapse { flex-wrap: nowrap; }
			.navbar .navbar-nav { flex-wrap: nowrap; white-space: nowrap; }
			.navbar .nav-link { white-space: nowrap; padding-left: .5rem; padding-right: .5rem; }
			.navbar .btn, .navbar .cart-link { white-space: nowrap; flex-shrink: 0; }
			.navbar a.nav-link, .navbar .nav-link {
				color: #d9dee0;
				font-weight: 600;
				border-radius: 6px;
			}
			.navbar a.nav-link:hover, .navbar a.nav-link.active {
				color: #fff;
				background: var(--s4w-charbon-mid);
			}
			.navbar .dropdown-menu {
				background: var(--s4w-charbon);
				border: 1px solid var(--s4w-charbon-mid);
			}
			.navbar .dropdown-item { color: #d9dee0; }
			.navbar .dropdown-item:hover, .navbar .dropdown-item:focus {
				background: var(--s4w-charbon-mid);
				color: #fff;
			}

			/* ---------- Burger mobile ---------- */
			.navbar-toggler {
				border: 2px solid var(--s4w-bleu-vif);
				border-radius: 8px;
				padding: .35rem .55rem;
				background: var(--s4w-charbon-mid);
			}
			.navbar-toggler:focus { box-shadow: 0 0 0 3px rgba(0, 180, 216, .35); }
			.navbar-toggler-icon {
				/* l'icône SVG utilise currentColor → on force un contraste clair */
				filter: invert(1) brightness(1.6);
			}

			/* ---------- Boutons ---------- */
			.btn-sinscrire {
				background: var(--s4w-rouge);
				color: #fff;
				font-weight: 700;
				border: none;
			}
			.btn-sinscrire:hover { background: var(--s4w-rouge-dark); color: #fff; }
			.btn-success { background: var(--s4w-bleu); border: none; } /* dons */
			.btn-success:hover { background: var(--s4w-bleu); filter: brightness(.9); }
			.btn-primary { background: var(--s4w-bleu); border: none; }
			.btn-primary:hover { background: var(--s4w-bleu); filter: brightness(.9); }
			.btn-outline-s4w {
				background: transparent;
				border: 2px solid var(--s4w-bleu-vif);
				color: var(--s4w-bleu);
				font-weight: 600;
			}
			.btn-outline-s4w:hover { background: var(--s4w-bleu-bg); color: var(--s4w-bleu); }

			/* ---------- Panier avec badge ---------- */
			.cart-link {
				color: #fff;
				border: 1px solid var(--s4w-charbon-mid);
				border-radius: 6px;
				padding: 6px 12px;
				font-weight: 600;
				font-size: .9rem;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 6px;
			}
			.cart-link:hover { background: var(--s4w-charbon-mid); color: #fff; }
			.cart-badge {
				background: var(--s4w-rouge);
				color: #fff;
				border-radius: 50%;
				min-width: 19px;
				height: 19px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-size: .72rem;
				font-weight: 800;
			}

			/* ---------- Lien administration (navbar) ---------- */
			.admin-link {
				background: var(--s4w-bleu-vif);
				color: var(--s4w-charbon);
				font-weight: 700;
				font-size: .88rem;
				padding: 6px 14px;
				text-decoration: none;
			}
			.admin-link:hover {
				background: var(--s4w-bleu);
				color: #fff;
			}

			/* ---------- Cartes activités ---------- */
			.card-body {
				background: #fff;
				border: 1px solid #e3e8ea;
				box-shadow: 0 2px 10px rgba(0, 150, 199, .08);
				border-radius: 10px;
				padding: 1.5rem;
				transition: transform .2s ease;
			}
			.card-activite:hover { transform: translateY(-5px); }
			.badge-essai {
				background: #fdecec;
				color: var(--s4w-rouge);
				border: 1px solid #f6c7cb;
				border-radius: 999px;
				padding: 3px 10px;
				font-size: .76rem;
				font-weight: 700;
				display: inline-block;
			}
			.badge-membre {
				background: var(--s4w-bleu-bg);
				color: var(--s4w-bleu);
				border: 1px solid #bfe4f2;
				border-radius: 999px;
				padding: 3px 10px;
				font-size: .76rem;
				font-weight: 700;
				display: inline-block;
			}
			.prix-from { font-weight: 800; color: var(--s4w-bleu); font-size: .92rem; }

			/* ---------- Hero overlay ---------- */
			.hero-s4w {
				background: linear-gradient(rgba(20,30,38,.72), rgba(20,30,38,.72)), url('{{ asset("img/danse.jpeg") }}') center/cover;
				color: #fff;
				border-radius: 12px;
				padding: 4rem 1.5rem;
				text-align: center;
			}
			.hero-s4w h1 { color: #fff; font-weight: 800; }
			.hero-s4w h1 em { font-style: normal; color: var(--s4w-bleu-vif); }

			/* ---------- Bandeau chiffres charbon ---------- */
			.darkstats {
				background: var(--s4w-charbon);
				color: #fff;
				padding: 2.5rem 1rem;
				border-radius: 12px;
			}
			.darkstats b { display: block; font-size: 1.6rem; font-weight: 800; color: var(--s4w-bleu-vif); }
			.darkstats small { color: #b9ccd6; }

			/* ---------- Ruban CTA ---------- */
			.ribbon-s4w {
				background: var(--s4w-bleu-bg);
				border-bottom: 1px solid #cfeaf4;
				padding: 12px 16px;
				font-size: .88rem;
				font-weight: 600;
				color: var(--s4w-bleu);
			}

			/* ---------- Bloc infos pratiques (pages discipline) ---------- */
			.infobox-s4w {
				background: var(--s4w-bleu-bg);
				border: 1px solid #cfeaf4;
				border-radius: 10px;
				padding: 1rem;
			}

			/* ---------- Stepper ---------- */
			.stepper-s4w { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
			.stepper-s4w .step {
				display: inline-flex; align-items: center; gap: .5rem;
				background: #fff; border: 1px solid #e3e8ea; border-radius: 999px;
				padding: .45rem .9rem; font-size: .85rem; font-weight: 700; color: var(--s4w-gris);
			}
			.stepper-s4w .step .num {
				width: 22px; height: 22px; border-radius: 50%;
				background: #e3e8ea; color: var(--s4w-encre);
				display: inline-flex; align-items: center; justify-content: center; font-size: .76rem;
			}
			.stepper-s4w .step.on { border-color: var(--s4w-bleu); background: var(--s4w-bleu-bg); color: var(--s4w-bleu); }
			.stepper-s4w .step.on .num { background: var(--s4w-bleu); color: #fff; }
			.stepper-s4w .step.done .num { background: #1e9e58; color: #fff; }

			/* ---------- Cartes formule (btn-check) ---------- */
			.formule-card {
				background: #fff;
				border: 2px solid #e3e8ea;
				border-radius: 10px;
				padding: 1rem;
				cursor: pointer;
				display: flex;
				gap: .9rem;
				align-items: center;
				transition: border-color .12s ease;
			}
			.formule-card:hover { border-color: var(--s4w-bleu-vif); }
			.formule-card .form-check-input { width: 20px; height: 20px; flex-shrink: 0; }
			.formule-card .prix { font-weight: 800; text-align: right; white-space: nowrap; }
			.formule-card .prix small { display: block; font-weight: 500; color: var(--s4w-gris); }

			/* ---------- Récap panier ---------- */
			.recap-s4w {
				background: #fff;
				border: 2px solid var(--s4w-bleu);
				border-radius: 10px;
				padding: 1.25rem;
			}
			.recap-s4w table { width: 100%; border-collapse: collapse; }
			.recap-s4w td { padding: .5rem 0; border-bottom: 1px dashed #e3e8ea; }
			.recap-s4w td:last-child { text-align: right; font-weight: 700; }
			.recap-s4w tr.total td { border: none; font-size: 1.15rem; font-weight: 800; color: var(--s4w-bleu); }
			.fiscal-note { color: #1e9e58; font-weight: 700; font-size: .86rem; }

			.alert-s4w-info {
				background: var(--s4w-bleu-bg);
				border: 1px solid var(--s4w-bleu-vif);
				color: #0a6d8a;
				border-radius: 8px;
				padding: .8rem 1rem;
				font-size: .92rem;
			}

			/* ---------- Planning ---------- */
			.planning-day-head {
				background: var(--s4w-charbon);
				color: #fff;
				font-weight: 700;
				padding: .7rem 1.1rem;
				border-radius: 10px 10px 0 0;
			}
			.planning-day-head.ponctuel { background: var(--s4w-bleu); }
			.planning-creneau {
				display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
				padding: .8rem 1.1rem;
				border: 1px solid #e3e8ea;
				border-top: none;
			}
			.planning-creneau:last-child { border-radius: 0 0 10px 10px; }
			.planning-creneau .heure { font-weight: 800; color: var(--s4w-bleu); min-width: 118px; }
			.planning-creneau .lieu { color: var(--s4w-gris); font-size: .86rem; flex: 1; min-width: 160px; }
			.niveau-pill {
				font-size: .74rem; font-weight: 700; color: var(--s4w-gris);
				border: 1px solid #e3e8ea; border-radius: 999px; padding: 2px 9px;
			}

			.container, .container-fluid { max-width: 1280px; margin-left: auto; margin-right: auto; }

			footer { background: var(--s4w-charbon); color: #b9ccd6; }
			footer h5 { color: #fff; }
			footer .text-dark { color: #b9ccd6 !important; }
			footer .text-dark:hover { opacity: .7; }

			/* ============ Mobile (burger) : annule l'anti-débordement desktop ============
			   ⚠️ Ce bloc doit rester EN FIN de <style>, après les règles navbar ci-dessus. */
			@media (max-width: 991.98px) {
				body { padding-top: 96px; }
				/* Le menu ouvert doit descendre SOUS le logo, pas rester à côté */
				.navbar .container-fluid { flex-wrap: wrap; }
				.navbar .navbar-collapse {
					flex-basis: 100%;        /* toute la largeur → aligné bord à bord */
					flex-wrap: wrap;
					background: var(--s4w-charbon);
					border-radius: 10px;
					margin-top: .75rem;
					padding: 1rem;
				}
				.navbar .navbar-nav { flex-direction: column; width: 100%; white-space: normal; }
				.navbar .navbar-collapse ul { padding-left: 0; margin-left: 0; }
			}
		</style>
		{% block style %}{% endblock %}
		{% block structured_data %}{% endblock %}
	</head>
	<body>

		<!-- ===== Topbar : compteur réseau 4Water (chiffres à jour) ===== -->
		<div class="topbar">
			<div class="container d-flex justify-content-between align-items-center flex-wrap gap-1">
				<span>💧 <strong>+ de 640 000 £</strong> reversés à WaterAid et Welthungerhilfe par le réseau 4Water</span>
				<span class="d-none d-md-inline">Bénévoles · 100 % des bénéfices reversés après frais</span>
			</div>
		</div>

		<header class="main_menu home_menu">
		<nav class="navbar navbar-expand-lg fixed-top">
			<div class="container-fluid">
				<a href="{{ path('home') }}" class="navbar-brand">
					<img src="{{ asset('img/logo.png') }}" alt="Logo Stras4Water" height="48">
				</a>
				<button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
						aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse" id="navbarSupportedContent">

					{# Mobile : boutons compte sous burger #}
					<div class="d-lg-none mb-3 text-center">
						{% if is_granted('ROLE_ACCUEIL') %}
							<a href="{{ path('admin_dashboard') }}" class="btn admin-link rounded-pill me-2 mb-2">
								<i class="bi bi-speedometer2 me-1"></i> Espace admin
							</a>
						{% endif %}
						{% if app.user %}
							<a href="{{ path('app_account') }}" class="btn btn-outline-s4w rounded-pill me-2 mb-2">Mon compte</a>
							<form method="post" action="{{ path('app_logout') }}" class="d-inline">
								<input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
								<button type="submit" class="btn btn-outline-danger rounded-pill mb-2">Se déconnecter</button>
							</form>
						{% else %}
							<a href="{{ path('app_login') }}" class="btn btn-outline-s4w rounded-pill me-2 mb-2">Se connecter</a>
						{% endif %}
					</div>

					<ul class="navbar-nav me-auto mb-2 mb-lg-0">
						<li class="nav-item"><a class="nav-link" href="{{ path('about') }}">Qui sommes-nous</a></li>

						{# Dropdown Activités #}
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" href="#" id="dropdownActivites" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								Activités
							</a>
							<ul class="dropdown-menu" aria-labelledby="dropdownActivites">
								<li><a class="dropdown-item" href="{{ path('rando') }}">Randonnées</a></li>
								<li class="dropend">
									<a class="dropdown-item dropdown-toggle" href="#" id="dropdownDanse" data-bs-toggle="dropdown" aria-expanded="false">Cours de danse</a>
									<ul class="dropdown-menu" aria-labelledby="dropdownDanse">
										<li><a class="dropdown-item" href="{{ path('bachata') }}">Bachata</a></li>
										<li><a class="dropdown-item" href="{{ path('salsa') }}">Salsa</a></li>
										<li><a class="dropdown-item" href="{{ path('kizomba') }}">Kizomba</a></li>
									</ul>
								</li>
								<li class="dropend">
									<a class="dropdown-item dropdown-toggle" href="#" id="dropdownLangue" data-bs-toggle="dropdown" aria-expanded="false">Cours de langue</a>
									<ul class="dropdown-menu" aria-labelledby="dropdownLangue">
										<li><a class="dropdown-item" href="{{ path('espagnol') }}">Espagnol</a></li>
										<li><a class="dropdown-item" href="{{ path('anglais') }}">Anglais</a></li>
									</ul>
								</li>
							</ul>
						</li>

						<li class="nav-item"><a class="nav-link" href="{{ path('planning') }}">📅 Planning</a></li>
						<li class="nav-item"><a class="nav-link" href="{{ path('adhesion') }}">Adhérer</a></li>
						<li class="nav-item"><a class="nav-link" href="{{ path('contact') }}">Contact</a></li>
					</ul>

					<div class="d-none d-lg-flex align-items-center gap-2 flex-shrink-0">
						<a href="{{ path('cart_show') }}" class="cart-link" aria-label="Voir le panier">
							<i class="bi bi-cart3"></i> Panier
							<span class="cart-badge">{{ cart_count }}</span>
						</a>

						{# Lien admin : bouton uniquement sur grands écrans (≥1200px
						   pour ne pas faire déborder la navbar à 1024px), sinon
						   accessible via le menu compte (dropdown) à toute largeur. #}
						{% if is_granted('ROLE_ACCUEIL') %}
							<a href="{{ path('admin_dashboard') }}" class="btn rounded-pill admin-link d-none d-xl-inline-flex">
								<i class="bi bi-speedometer2 me-1"></i> Admin
							</a>
						{% endif %}

						<div class="dropdown">
							<button class="btn btn-outline-s4w dropdown-toggle d-flex align-items-center" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="bi bi-person-circle me-2"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
								{% if app.user %}
									<li><a class="dropdown-item" href="{{ path('app_account') }}">Mon compte</a></li>
									{% if is_granted('ROLE_ACCUEIL') %}
										<li><hr class="dropdown-divider"></li>
										<li><a class="dropdown-item" href="{{ path('admin_dashboard') }}">
											<i class="bi bi-speedometer2 me-1"></i> Espace admin
										</a></li>
									{% endif %}
									<li><hr class="dropdown-divider"></li>
									<li><a class="dropdown-item" href="{{ path('app_logout') }}">Se déconnecter</a></li>
								{% else %}
									<li><a class="dropdown-item" href="{{ path('app_login') }}">Se connecter</a></li>
								{% endif %}
							</ul>
						</div>

						{# CTA principal — rouge, toujours visible #}
						<a href="{{ path('home') }}#activites" class="btn btn-sinscrire rounded-pill">S'inscrire à un cours</a>

						<a href="{{ path('donation') }}" class="btn btn-success rounded-pill" aria-label="Faire un don">Je fais un don</a>
					</div>

					{# Mobile : CTA + panier en bas du burger #}
					<div class="d-lg-none mt-3 text-center">
						<hr class="border-secondary">
						<div class="d-flex flex-column gap-2">
							<a href="{{ path('home') }}#activites" class="btn btn-sinscrire rounded-pill">S'inscrire à un cours</a>
							<a href="{{ path('donation') }}" class="btn btn-success rounded-pill">Je fais un don</a>
							<a href="{{ path('cart_show') }}" class="btn btn-outline-s4w rounded-pill">
								<i class="bi bi-cart3 me-1"></i> Panier ({{ cart_count }})
							</a>
						</div>
					</div>

				</div>
			</div>
		</nav>
		</header>

		<div class="container-fluid">
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			{% endfor %}
		{% endfor %}
		</div>

		{% block body %}{% endblock %}
		
		<div id="cookie-banner" class="bg-light text-dark p-3 border-top shadow-sm fixed-bottom d-none" style="z-index: 1050;">
			<div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
				<p class="mb-2 mb-md-0 small">
